{
  "kind": "calculated",
  "unit": "指標スコア（0〜1）",
  "year": "2020〜2024（指標ごとの公表年。所得は失業率の調査年に合わせて2020年度。所得の公表の最新は2021年度）",
  "label": "上位3県の指標別スコア",
  "inputs": [
    {
      "rankingKey": "per-capita-prefectural-income-h27",
      "year": "2020",
      "label": "１人当たり県民所得",
      "direction": "高いほど良い",
      "source": "r2:app/ranking/per-capita-prefectural-income-h27/values.json"
    },
    {
      "rankingKey": "violent-crime-per-100k",
      "year": "2023",
      "label": "粗暴犯認知件数",
      "direction": "低いほど良い",
      "source": "r2:app/ranking/violent-crime-per-100k/values.json"
    },
    {
      "rankingKey": "general-hospital-count-per-100k",
      "year": "2023",
      "label": "一般病院数（人口10万人当たり）",
      "direction": "高いほど良い",
      "source": "r2:app/ranking/general-hospital-count-per-100k/values.json"
    },
    {
      "rankingKey": "owner-occupied-housing-ratio",
      "year": "2023",
      "label": "持ち家比率",
      "direction": "高いほど良い",
      "source": "r2:app/ranking/owner-occupied-housing-ratio/values.json"
    },
    {
      "rankingKey": "private-rental-housing-rent-per-3-3m2",
      "year": "2024",
      "label": "民営家賃（3.3m²当たり月額）",
      "direction": "低いほど良い",
      "source": "r2:app/ranking/private-rental-housing-rent-per-3-3m2/values.json"
    },
    {
      "rankingKey": "total-fertility-rate",
      "year": "2023",
      "label": "合計特殊出生率",
      "direction": "高いほど良い",
      "source": "r2:app/ranking/total-fertility-rate/values.json"
    },
    {
      "rankingKey": "unemployment-rate",
      "year": "2020",
      "label": "完全失業率",
      "direction": "低いほど良い",
      "source": "r2:app/ranking/unemployment-rate/values.json"
    },
    {
      "rankingKey": "maximum-temperature",
      "year": "2024",
      "label": "最高気温（日最高気温の月平均の最高値）",
      "direction": "低いほど良い",
      "source": "r2:app/ranking/maximum-temperature/values.json"
    }
  ],
  "formula": "指標スコア = composite-ranking.json と同じ式（高いほど良い指標は (47 - r) / 46、低いほど良い指標は (r - 1) / 46。r は R2 values.json の rank）。総合スコア上位3県を描く。",
  "transform": "top3 of composite-ranking",
  "upstream": "composite-ranking.source.json"
}
