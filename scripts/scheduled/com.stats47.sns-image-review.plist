<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SNS 投稿画像の週次確認 (毎週日曜 07:30 JST)。ローカル Mac 限定。
  スリープ中に時刻が来た回は、起きたときに 1 回にまとめて実行される。
  インストール:
    cp scripts/scheduled/com.stats47.sns-image-review.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.stats47.sns-image-review.plist
  アンインストール:
    launchctl unload ~/Library/LaunchAgents/com.stats47.sns-image-review.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stats47.sns-image-review</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/minamidaisuke/stats47/scripts/scheduled/sns-image-review.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/minamidaisuke/stats47</string>
    <key>StandardOutPath</key>
    <string>/Users/minamidaisuke/Library/Logs/stats47/sns-image-review.launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/minamidaisuke/Library/Logs/stats47/sns-image-review.launchd.err</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
