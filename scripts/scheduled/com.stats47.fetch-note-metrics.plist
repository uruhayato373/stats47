<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  note ダッシュボードの記事別閲覧の週次取得 (土曜 08:00 JST。2026-10-26 に月曜 09:15 から移動。土曜 07:00 の認証付き計測の後)。ローカル Mac 限定。
  インストール:
    cp scripts/scheduled/com.stats47.fetch-note-metrics.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.stats47.fetch-note-metrics.plist
  アンインストール:
    launchctl unload ~/Library/LaunchAgents/com.stats47.fetch-note-metrics.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stats47.fetch-note-metrics</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/minamidaisuke/stats47/scripts/scheduled/fetch-note-metrics.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/minamidaisuke/stats47</string>
    <key>StandardOutPath</key>
    <string>/Users/minamidaisuke/Library/Logs/stats47/fetch-note-metrics.launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/minamidaisuke/Library/Logs/stats47/fetch-note-metrics.launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
