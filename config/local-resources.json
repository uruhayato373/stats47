{
  "schemaVersion": 2,
  "diskWarnGiB": 25,
  "diskCriticalGiB": 15,
  "memoryWarnGiB": 3,
  "memoryCriticalGiB": 1.5,
  "cacheAgeDays": 7,
  "historyDays": 30,
  "scanTimeoutSeconds": 120,
  "cachePaths": [
    "apps/web/.next/cache",
    "apps/admin/.next/cache",
    "apps/web/.next/standalone/apps/web/.next/cache",
    {
      "path": ".turbo/cache/*",
      "ageDays": 7
    },
    {
      "path": ".local/r2/*",
      "ageDays": 7,
      "exclude": [
        "sns"
      ]
    },
    {
      "path": ".local/verification/release/*",
      "ageDays": 30
    },
    {
      "path": ".local/verification/seo/*",
      "ageDays": 30
    },
    {
      "path": ".local/verification/x-visuals/*",
      "ageDays": 30
    },
    {
      "path": ".local/tmp",
      "ageDays": 7
    },
    {
      "path": ".local/rakuten-cli-test-*",
      "ageDays": 7
    },
    {
      "path": ".local/regen-*",
      "ageDays": 7
    },
    {
      "path": ".local/geo-source-*",
      "ageDays": 30
    }
  ],
  "scratchRoots": {
    "win32": [
      "C:/tmp"
    ],
    "darwin": [
      "/tmp"
    ]
  },
  "scratchPrefix": "stats47-",
  "scratchAgeDays": 14,
  "scratchCachePaths": [
    {
      "path": "stats47-geo-ui/*.zip",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/*_GML",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/a38-source-level-*",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/thumbnail-inputs",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.shp",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.dbf",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.shx",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.prj",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/attribute-input",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/sharp-runtime",
      "ageDays": 1
    },
    {
      "path": "mlit-ksj-*",
      "ageDays": 1
    }
  ],
  "scratchExclude": [
    "stats47-source-vault*",
    "stats47-japan-zue-*",
    "stats47-geo-ui"
  ],
  "protectedPaths": [
    "books",
    "docs/books",
    ".claude/pdfs",
    ".local/affiliate-status"
  ],
  "fileRetention": [
    {
      "root": "~/.claude/projects",
      "match": "*.jsonl",
      "ageDays": 7,
      "excludeDirs": [
        "memory"
      ],
      "why": "Claude Code の会話記録。cleanupPeriodDays: 7 がサブエージェントの記録を残すため回収する。memory は repo の .claude/memory を指すリンクで対象外"
    },
    {
      "root": "~/.codex/sessions",
      "match": "*",
      "ageDays": 30,
      "why": "Codex の会話記録。知見は repo (.claude/rules・skills・memory・backlog) に残す運用で、記録は直近の再開用"
    },
    {
      "root": "~/.codex/archived_sessions",
      "match": "*",
      "ageDays": 30,
      "why": "Codex のアーカイブ済み会話記録"
    },
    {
      "root": "~/.codex/generated_images",
      "match": "*",
      "ageDays": 30,
      "why": "Codex の生成画像。採用した画像は git (assets/) か R2 に置く規則"
    }
  ],
  "footprintBudgets": [
    {
      "path": ".local",
      "maxGiB": 8
    },
    {
      "path": "apps/web/.next",
      "maxGiB": 4
    },
    {
      "path": "~/.claude/projects",
      "maxGiB": 5
    },
    {
      "path": "~/.codex/sessions",
      "maxGiB": 3
    },
    {
      "path": "~/.codex/archived_sessions",
      "maxGiB": 2
    },
    {
      "path": "~/.codex/generated_images",
      "maxGiB": 2
    }
  ]
}
