  "scratchRoots": {
    "win32": [
      "C:/tmp"
    ],
    "darwin": [
      "/tmp"
    ]
  },
  "scratchPrefix": "stats47-",
  "scratchAgeDays": 14,
  "scratchCachePaths": [
    {
      "path": "stats47-geo-ui/*.zip",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/*_GML",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/a38-source-level-*",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/thumbnail-inputs",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.shp",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.dbf",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.shx",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/A38-20_*.prj",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/attribute-input",
      "ageDays": 1
    },
    {
      "path": "stats47-geo-ui/sharp-runtime",
      "ageDays": 1
    },
    {
      "path": "mlit-ksj-*",
      "ageDays": 1
    }
  ],
  "scratchExclude": [
    "stats47-source-vault*",
    "stats47-japan-zue-*",
    "stats47-geo-ui"
  ],
  "protectedPaths": [
    "books",
    "docs/books",
    ".claude/pdfs",
    ".local/affiliate-status"
  ],
  "fileRetention": [
    {
      "root": "~/.claude/projects",
      "match": "*.jsonl",
      "ageDays": 7,
      "excludeDirs": [
        "memory"
      ],
      "why": "Claude Code の会話記録。cleanupPeriodDays: 7 がサブエージェントの記録を残すため回収する。memory は repo の .claude/memory を指すリンクで対象外"
    },
    {
      "root": "~/.codex/sessions",
      "match": "*",
      "ageDays": 7,
      "why": "Codex の会話記録。知見は repo (.claude/rules・skills・memory・backlog) に残す運用で、記録は直近の再開用。一括生成で数日に数十GB溜まるため maxGiB 超過分も古い順に回収する (2026-11-08)",
      "maxGiB": 2
    },
    {
      "root": "~/.codex/archived_sessions",
      "match": "*",
      "ageDays": 7,
      "why": "Codex のアーカイブ済み会話記録。一括生成で数日に数十GB溜まるため maxGiB 超過分も古い順に回収する (2026-11-08)",
      "maxGiB": 1
    },
    {
      "root": "~/.codex/generated_images",
      "match": "*",
      "ageDays": 7,
      "why": "Codex の生成画像。採用した画像は git (assets/) か R2 に置く規則。一括生成で数日に数十GB溜まるため maxGiB 超過分も古い順に回収する (2026-11-08)",
      "maxGiB": 1
    },
    {
      "root": ".local/r2/sns",
      "match": "*",
      "ageDays": 30,
      "maxGiB": 0.5,
      "why": "X / Threads / Instagram 画像の生成・予約の作業領域。画像の正本は private R2 の sns-assets/ (archive-sns-assets.mjs が予約・投稿後に保全)。予約時に無ければ publish-x / publish-threads が private R2 から戻す (2026-11-08)"
    }
  ],
  "footprintBudgets": [
    {
      "path": ".local",
      "maxGiB": 8
    },
    {
      "path": "apps/web/.next",
      "maxGiB": 4
    },
    {
      "path": "~/.claude/projects",
      "maxGiB": 5
    },
    {
      "path": "~/.codex/sessions",
      "maxGiB": 3
    },
    {
      "path": "~/.codex/archived_sessions",
      "maxGiB": 2
    },
    {
      "path": "~/.codex/generated_images",
      "maxGiB": 2
    },
    {
      "path": "~/.codex/thread_history_1.sqlite",
      "maxGiB": 1
    }
  ],
  "localRegistry": [
    {
      "pattern": "playwright-*-profile",
      "kind": "auth",
      "why": "ログイン済みブラウザ。refresh-session が playwright-${source}-profile で開く"
    },
    {
      "pattern": "playwright-*-state.json",
      "kind": "auth",
      "why": "ログイン状態の書き出し"
    },
    {
      "pattern": "kdp-account.local.json",
      "kind": "auth",
      "why": "KDP アカウント照合の手元値"
    },
    {
      "pattern": "owner-browser-allow.*",
      "kind": "auth",
      "why": "オーナーが会話で許可した管理画面の記録 (recorded-measurement-first)"
    },
    {
      "pattern": "affiliate-status",
      "kind": "state",
      "why": "ASP の提携状態。protectedPaths"
    },
    {
      "pattern": "affiliate-ops",
      "kind": "state",
      "why": "ASP 操作の記録 (asp-operation-store)"
    },
    {
      "pattern": "authenticated-*",
      "kind": "state",
      "why": "土曜の認証付き計測の受け渡し"
    },
    {
      "pattern": "product-sales-evidence",
      "kind": "state",
      "why": "販売実績の取得証跡"
    },
    {
      "pattern": "product-portfolio",
      "kind": "state",
      "why": "商品ポートフォリオの派生レポート"
    },
    {
      "pattern": "selection-backfill",
      "kind": "state",
      "why": "ThemeCatalog selection の夜間 backfill の進捗"
    },
    {
      "pattern": "geo-content-pipeline",
      "kind": "state",
      "why": "Geo の非公開運用台帳 (r2-storage-design.md)"
    },
    {
      "pattern": "weekly-audits",
      "kind": "state",
      "why": "週次監査の結果。管理画面が読む"
    },
    {
      "pattern": "sns-review",
      "kind": "state",
      "why": "予約中 SNS 画像の週次確認の最新結果"
    },
    {
      "pattern": "session-preflight",
      "kind": "state",
      "why": "保存済みセッションの日次の事前確認の最新結果 (session-preflight.sh が上書き。管理画面 /ops/auth が読む)"
    },
    {
      "pattern": "note-card-repair-journal.json",
      "kind": "state",
      "why": "note カード修復の journal"
    },
    {
      "pattern": "x-posted.jsonl",
      "kind": "state",
      "why": "X 投稿の確認記録"
    },
    {
      "pattern": "threads-scheduled.jsonl",
      "kind": "state",
      "why": "Threads 予約の記録"
    },
    {
      "pattern": "resource-health",
      "kind": "state",
      "why": "ローカル資源の日次点検の記録"
    },
    {
      "pattern": "locks",
      "kind": "state",
      "why": "実行中の処理の排他ロック"
    },
    {
      "pattern": "verification",
      "kind": "state",
      "why": "検証出力の親。中身は cachePaths が期限で消す"
    },
    {
      "pattern": "r2",
      "kind": "state",
      "why": "R2 push staging の親。中身は cachePaths .local/r2/* (sns 以外) と fileRetention .local/r2/sns (ファイル単位 30 日・0.5GiB) が回収する"
    },
    {
      "pattern": "tsbuildinfo",
      "kind": "state",
      "why": "型検査の incremental cache"
    },
    {
      "pattern": "*-cache.json",
      "kind": "state",
      "why": "pre-commit の stat キャッシュ"
    },
    {
      "pattern": "stop-docs-success.json",
      "kind": "state",
      "why": "Stop hook の文書検査の成功記録"
    },
    {
      "pattern": "kindle-private",
      "kind": "product",
      "why": "KDP セレクト専用本の非公開原稿。book-catalog が packages/product-factory/.local/kindle-private を読む (repo に入れない)。控えは Drive stats47/Kindle原稿/K-S1-13-v1-20261104-r8"
    },
    {
      "pattern": "sns-gallery-state.json",
      "kind": "state",
      "why": "管理画面のギャラリー固有の状態"
    },
    {
      "pattern": "measurement-lock-hash",
      "kind": "state",
      "why": "土曜の認証付き計測が依存の変化を検知するハッシュ"
    },
    {
      "pattern": "note-card-*journal.json",
      "kind": "state",
      "why": "note カード修復・画像差し替えの再開用 journal"
    },
    {
      "pattern": "seo-rank-watch",
      "kind": "state",
      "why": "検索順位の定点観測の記録"
    }
  ],
  "codexThreadHistory": {
    "stateDb": "~/.codex/state_5.sqlite",
    "historyDb": "~/.codex/thread_history_1.sqlite",
    "why": "Codex の会話の投影 DB。元の記録 (sessions) を期限で消しても行が残るので、記録の消えた exec スレッドの行だけを日次で消す。ファイル名の版が変わったらここを直す"
  }
}
