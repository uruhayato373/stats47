{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "事業計画の指標と KPI ツリー",
  "description": "data/business-plan/plan/metrics.json の形状契約。事業計画の指標 (並びが表示順)。kpiTier を持つ指標だけが KPI ツリー (data/business-plan/kpi-tree.json。buildKpiTree が作る) に載り、施策 (.claude/todo/improvements.md の [kpi: id]) と戦略レーン表の KPI 列が参照できる。nsm は月次で見る最終成果、driver は週次で動かす駆動 KPI、guardrail は悪化させてはいけない守りの指標。駆動 KPI とガードレールの値は build-measurement-cycle.mjs が週次に集計する。目標値は根拠 (過去事例か計算式) が揃うまで書かない (evidence-based-judgment 状況4)。読み込み口は packages/data-configs/src/business-plan/catalog.ts (BUSINESS_PLAN_METRICS)。",
  "type": "object",
  "required": ["metrics"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "role", "cadence", "source", "measurementStatus", "unit", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "role": { "enum": ["north-star", "input", "guardrail", "hypothesis"] },
          "kpiTier": { "description": "KPI ツリーに載せる指標だけが持つ。無いものは事業計画上の仮説・参考指標", "enum": ["nsm", "driver", "guardrail"] },
          "cadence": { "enum": ["daily", "weekly", "monthly", "quarterly"] },
          "source": { "type": "string", "minLength": 1 },
          "measurementStatus": { "enum": ["measured", "partially-measured", "not-instrumented", "manual"] },
          "targetM3": { "type": "number" },
          "targetM6": { "type": "number" },
          "targetM12": { "type": "number" },
          "kpiTarget": {
            "description": "週次 KPI 表に出す目標。期日 (ISO 週) と根拠の計算式を必ず持つ。根拠が揃わない KPI は持たない。M3/M6/M12 は起点が定義されていないので KPI 表には使わない",
            "type": "object",
            "required": ["value", "dueWeek", "basis"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "number" },
              "dueWeek": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "unit": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
