{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productId",
    "included",
    "examples",
    "filePreview",
    "showcaseNote"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "deliveryVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "key",
        "sha256"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sourceArticle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articleKey",
        "store",
        "manifestSha256"
      ],
      "properties": {
        "articleKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "store": {
          "const": "r2-private"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "selectedMetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "year",
          "unit"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "year": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "included": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "figures"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "figures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "alt",
                "template",
                "sha256"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+\\.png$"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "template": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "filePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "lead",
        "figures"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lead": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "alt",
              "template",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.png$"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "showcaseNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "analysisRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "version",
        "planSha256",
        "sources",
        "results",
        "files",
        "resolvedPlanSha256"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "grain",
              "years",
              "retrievedAt",
              "tableTitle",
              "rows",
              "areas",
              "missing",
              "inputSha256",
              "inputs",
              "coverage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "grain": {
                "enum": [
                  "prefecture",
                  "municipality"
                ]
              },
              "years": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              },
              "retrievedAt": {
                "type": "string",
                "minLength": 1
              },
              "tableTitle": {
                "type": "string",
                "minLength": 1
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "areas": {
                "type": "integer",
                "minimum": 0
              },
              "missing": {
                "type": "integer",
                "minimum": 0
              },
              "inputSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metricKey",
                    "statsDataId",
                    "code",
                    "unit"
                  ],
                  "properties": {
                    "metricKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "variantId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statsDataId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rawUnit": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "coverage": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "year",
                    "total",
                    "kept",
                    "dropped",
                    "share",
                    "compareColumn",
                    "keptMedian",
                    "droppedMedian",
                    "status"
                  ],
                  "properties": {
                    "year": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kept": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "dropped": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "compareColumn": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "keptMedian": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "droppedMedian": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "warn"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "results": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "bytes"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "resolvedPlanSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "sourceArchive",
        "deliveryVersion",
        "manifestSha256",
        "selectedMetrics"
      ]
    },
    {
      "required": [
        "sourceArticle",
        "sourceArchive"
      ]
    }
  ]
}
