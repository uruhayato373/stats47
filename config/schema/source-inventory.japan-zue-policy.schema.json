{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "日本国勢図会の解決方針",
  "description": "data/source-inventory/japan-zue/policy.json の形状契約。policyVersion・reviewedAt は解決した項目の review に刻む版と確認日、governmentTermsUrl は政府標準利用規約の URL。sourcePolicies は所管機関と公式 landing URL・利用条件 (並びが照合の優先順。出典の機関名に当てる正規表現は読み込み口 packages/data-configs/src/evidence-inventory/japan-zue/policy.ts の SOURCE_POLICY_PATTERNS が organization で結ぶ。片方だけにある organization は読み込み時に止まる)。manualOverrides は人手で意味を確認した例外の解決 (キーは解決台帳の項目 ID。WP4 の試行を含む)。解決の関数 (resolveSourcePolicy・resolveJapanZueCandidate) はコードにある。",
  "type": "object",
  "required": ["policyVersion", "reviewedAt", "governmentTermsUrl", "sourcePolicies", "manualOverrides"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "governmentTermsUrl": { "type": "string", "pattern": "^https://" },
    "sourcePolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["organization", "url", "rights"],
        "additionalProperties": false,
        "properties": {
          "organization": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "termsUrl": { "type": "string", "pattern": "^https://" },
          "rights": { "$ref": "#/definitions/rights" }
        }
      }
    },
    "manualOverrides": {
      "type": "object",
      "propertyNames": { "pattern": "^japan-zue-\\d{4}-\\d{2}-p\\d{3}-[a-z]+\\d{2}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["resolution", "resolutionReason"],
        "additionalProperties": false,
        "properties": {
          "resolution": { "enum": ["unreviewed", "reuse-existing-metric", "new-metric", "combined-analysis", "context-only", "primary-source-unavailable", "rights-hold", "not-quantitative", "not-applicable"] },
          "resolutionReason": { "type": "string", "minLength": 1 },
          "metricKeys": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
          "primarySource": { "$ref": "#/definitions/primarySource" },
          "primarySources": { "type": "array", "items": { "$ref": "#/definitions/primarySource" } },
          "contentRoles": { "type": "array", "items": { "enum": ["ranking", "survey", "theme", "area", "japan", "blog", "note", "kindle", "youtube", "instagram", "x", "agent", "skill", "internal-documentation"] } },
          "units": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "geoScopes": { "type": "array", "items": { "enum": ["prefecture-set", "prefecture", "municipality-set", "japan", "world"] } }
        }
      }
    }
  },
  "definitions": {
    "rights": { "enum": ["allowed", "needs-review", "blocked"] },
    "primarySource": {
      "type": "object",
      "required": ["organization", "publicationOrDataset", "url", "dataYears", "checkedAt", "rights"],
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "publicationOrDataset": { "type": "string", "minLength": 1 },
        "datasetId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "termsUrl": { "type": "string", "pattern": "^https://" },
        "dataYears": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}$" } },
        "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rights": { "$ref": "#/definitions/rights" }
      }
    }
  }
}
