{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "e-Stat 外オープンデータのデータセットの台帳",
  "description": "data/open-data/catalog/datasets.json の形状契約。配列の並びが export の並び (OPEN_DATASETS) になるので変えない。ID は kebab-case で書いた値を固定し、テンプレートから作り直さない。sourceId は open-data.sources、existingGisDataIds は geo.ksj-datasets、existingMetricKeys は指標の registry、suggestedCategories は categories.master を指す。不明な値を空文字で埋めない。列挙値は packages/data-configs/src/open-data-catalog/types.ts と同じ。読み込みは packages/data-configs/src/open-data-catalog/datasets.ts。",
  "type": "object",
  "required": ["datasets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "sourceId", "name", "description", "landingPageUrl", "accessMethods", "formats", "geographicLevels",
          "hasGeometry", "coverage", "updateFrequency", "license", "stats47Uses", "suggestedCategories",
          "existingMetricKeys", "existingGisDataIds", "candidateMetricConcepts", "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "landingPageUrl": { "type": "string", "pattern": "^https://" },
          "downloadUrl": { "type": "string", "pattern": "^https://" },
          "accessMethods": { "type": "array", "items": { "enum": ["api", "bulk-download", "file-download", "tile-service", "web-only"] } },
          "formats": { "type": "array", "items": { "enum": ["csv", "xlsx", "json", "geojson", "shapefile", "gml", "citygml", "geotiff", "vector-tile", "other"] } },
          "geographicLevels": { "type": "array", "items": { "enum": ["national", "prefecture", "municipality", "district", "mesh", "point", "line", "polygon"] } },
          "hasGeometry": { "type": "boolean" },
          "geometryTypes": { "type": "array", "items": { "enum": ["point", "line", "polygon", "mesh", "3d"] } },
          "coordinateReferenceSystem": { "type": "string", "minLength": 1 },
          "coverage": { "enum": ["all-japan", "partial", "prefecture-specific"] },
          "timeCoverage": { "type": "string", "minLength": 1 },
          "updateFrequency": { "enum": ["realtime", "daily", "monthly", "quarterly", "annual", "irregular", "static", "unknown"] },
          "latestPublishedAt": { "type": "string", "minLength": 1 },
          "license": {
            "type": "object",
            "required": ["name", "commercialUse", "attributionRequired", "modificationNoticeRequired", "termsUrl"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "commercialUse": { "enum": ["allowed", "restricted", "unknown"] },
              "attributionRequired": { "type": "boolean" },
              "modificationNoticeRequired": { "type": "boolean" },
              "termsUrl": { "type": "string", "pattern": "^https://" }
            }
          },
          "stats47Uses": { "type": "array", "items": { "enum": ["ranking", "theme", "map", "area", "research-only", "not-suitable"] } },
          "suggestedCategories": { "description": "カテゴリ 17 軸のキー", "type": "array", "items": { "type": "string" } },
          "existingMetricKeys": { "description": "既存の指標と重複する rankingKey", "type": "array", "items": { "type": "string" } },
          "existingGisDataIds": { "description": "既存の KSJ 台帳と重複する dataId", "type": "array", "items": { "type": "string" } },
          "candidateMetricConcepts": { "description": "未採用の指標候補の概念。取得可能性を実証したものだけ指標バックログへ渡す", "type": "array", "items": { "type": "string" } },
          "verification": {
            "type": "object",
            "required": ["status", "verifiedAt", "verifiedFromUrls"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["verified", "partially-verified", "unverified", "unavailable", "deprecated"] },
              "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "verifiedFromUrls": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
