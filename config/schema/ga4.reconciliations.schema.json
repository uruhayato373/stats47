{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GA4 weekly aggregate reconciliation evidence",
  "type": "object",
  "required": ["observedAt", "week", "definition", "total", "canonical", "channelsSum", "oldSnapshotPreserved"],
  "additionalProperties": false,
  "properties": {
    "observedAt": { "type": "string", "format": "date-time" },
    "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "definition": { "type": "string", "minLength": 1 },
    "total": {
      "type": "object",
      "required": ["thisUsers", "prevUsers", "thisSessions", "prevSessions", "thisEngagedSessions", "prevEngagedSessions"],
      "additionalProperties": { "type": "number" }
    },
    "canonical": {
      "type": "object", "required": ["current", "previous"], "additionalProperties": false,
      "properties": { "current": { "$ref": "#/definitions/aggregate" }, "previous": { "$ref": "#/definitions/aggregate" } }
    },
    "channelsSum": {
      "type": "object", "required": ["users", "sessions", "engaged"],
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "oldSnapshotPreserved": { "const": true }
  },
  "definitions": {
    "aggregate": {
      "type": "object", "required": ["activeUsers", "sessions", "engagedSessions", "pageviews", "engagementRate"],
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
