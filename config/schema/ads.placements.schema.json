{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "広告の枠の台帳",
  "description": "config/ads/placements.json の形状契約 (2026-10-29 作成)。広告の大きさの語彙・枠の種類 (確保する箱の寸法・受け入れる大きさ・表示する画面幅)・ページごとの置き方・共通のルールを持つ。広告そのもの (案件・クリエイティブ) の正本は apps/web/scripts/affiliate-ads-data.ts と AdSense の枠の定数で、ここは置き方だけを持つ。",
  "type": "object",
  "required": [
    "sizes",
    "slotTypes",
    "pages",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "_doc": {
      "type": "string"
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "size",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "pattern": "^(\\d+x\\d+|text)$",
            "description": "アフィリエイト広告の大きさ (幅x高さ) かテキスト"
          },
          "status": {
            "enum": [
              "standard",
              "undecided",
              "retired"
            ],
            "description": "standard = 新規登録できる語彙 / undecided = オーナー判断待ち / retired = 退役"
          },
          "fitsInto": {
            "type": "string",
            "pattern": "^\\d+x\\d+$",
            "description": "この大きさを入れる枠の大きさ (250x250 は 300x250 の枠の中央に置く)"
          },
          "adIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "この大きさの登録 (一点物の判断対象)。standard は件数が多いので書かない"
          },
          "reason": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "slotTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "box",
          "devices",
          "accepts",
          "component"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "adsense",
              "affiliate"
            ]
          },
          "box": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "description": "確保する箱。width は数値 (px) か full (本文の幅いっぱい)",
            "properties": {
              "width": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "const": "full"
                  }
                ]
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "columns": {
                "type": "object",
                "required": [
                  "desktop",
                  "mobile"
                ],
                "additionalProperties": false,
                "description": "1 つの枠に広告を横に並べる数 (PR の列)",
                "properties": {
                  "desktop": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mobile": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "mobileWidth": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "const": "full"
                  }
                ],
                "description": "モバイルで箱の幅が違うときだけ (右レールの枠は本文の下に積まれて幅いっぱいになる)"
              },
              "mobileHeight": {
                "type": "integer",
                "minimum": 1,
                "description": "モバイルで実物の高さが違うときだけ (本番の実測)"
              }
            }
          },
          "devices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "desktop",
                "mobile"
              ]
            }
          },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(\\d+x\\d+|text|adsense:(rectangle|article|multiplex|skyscraper))$"
            },
            "description": "受け入れる広告 (アフィリエイトは sizes の大きさ、AdSense は adsense:<形式>)"
          },
          "component": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "この枠を描く部品"
          },
          "measured": {
            "type": "string",
            "description": "本番で測った実物の大きさと日付 (箱の寸法の根拠)"
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "description": "ページの種類 → 置く枠の並び (上から順)。まだ台帳に載せていないページの種類は書かない",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "slot",
            "region",
            "position",
            "source",
            "marker"
          ],
          "additionalProperties": false,
          "properties": {
            "slot": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "slotTypes の id"
            },
            "position": {
              "type": "string",
              "minLength": 1,
              "description": "ページの中の位置 (何の後か)"
            },
            "adsenseSlot": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "AdSense の枠の定数名 (apps/web/src/lib/google-adsense/constants.ts)"
            },
            "trackingPosition": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "アフィリエイトの計測の position (GA4 の link_position)"
            },
            "region": {
              "enum": [
                "body",
                "rail"
              ],
              "description": "本文か右レールか"
            },
            "source": {
              "type": "string",
              "pattern": "^apps/web/src/.+\\.tsx$",
              "description": "この枠を置いているファイル"
            },
            "marker": {
              "type": "string",
              "minLength": 4,
              "description": "source の中でこの枠を置いている箇所の文字列 (照合テストが位置と順を見る)"
            },
            "devices": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "desktop",
                  "mobile"
                ]
              },
              "description": "この置き方が出る画面幅 (省略は枠の種類の devices)"
            },
            "condition": {
              "type": "string",
              "minLength": 4,
              "description": "条件で入れ替わる・出ないときの説明"
            },
            "knownAdjacentReason": {
              "type": "string",
              "minLength": 4,
              "description": "直前の枠と隣り合わせになっている (共通のルールの例外) 理由。直す判断が出るまでの記録で、増やさない"
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "noAdjacentSlots",
        "noFirstView",
        "maxAdsenseBodyPerPage"
      ],
      "additionalProperties": false,
      "properties": {
        "noAdjacentSlots": {
          "type": "boolean",
          "description": "広告の枠同士を間に内容を挟まずに並べない"
        },
        "noFirstView": {
          "type": "boolean",
          "description": "最初の画面 (h1 と操作の行・最初の章) には置かない"
        },
        "maxAdsenseBodyPerPage": {
          "type": "integer",
          "minimum": 0,
          "description": "本文の AdSense の枠の上限"
        }
      }
    }
  }
}
