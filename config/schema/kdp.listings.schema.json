{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KDP の出品内容と公開・審査状態",
  "description": "config/kdp-listings.json の形状契約。項目は packages/product-factory/src/channels/kindle/export-kdp-listings.ts の KdpListing と、本棚の read-back を書き戻す .claude/scripts/kdp/lib/kdp-{status,publication-stage,session}.mjs が持つもの。2026-10-26 に推論版 (anyOf の入れ子) から厳格化した (項目の追加は properties に足してから書く)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["listings"],
  "properties": {
    "_note": { "type": "string" },
    "listings": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/kindleBookId" },
      "additionalProperties": { "$ref": "#/definitions/listing" }
    }
  },
  "definitions": {
    "nullableString": { "type": ["string", "null"] },
    "nullableDate": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/date" }] },
    "publicationStage": {
      "description": "出版工程の状態機械 (一方向)。KDP_PUBLICATION_STAGES と同じ並び",
      "enum": ["prepared", "details_filled", "files_processed", "verified", "submitted", "live", "previous_unpublished"]
    },
    "edition": {
      "description": "書誌と出品状態 (現行版と previousEditions の旧版で共通)",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/kindleBookId" },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "subtitle": { "$ref": "#/definitions/nullableString" },
        "author": { "type": "string" },
        "authorLastName": { "type": "string" },
        "authorFirstName": { "type": "string" },
        "authorKana": { "type": "string" },
        "authorRomaji": { "type": "string" },
        "titleKana": { "type": "string" },
        "titleRomaji": { "type": "string" },
        "subtitleKana": { "$ref": "#/definitions/nullableString" },
        "subtitleRomaji": { "$ref": "#/definitions/nullableString" },
        "readingSourceTitle": { "type": "string" },
        "readingSourceSubtitle": { "$ref": "#/definitions/nullableString" },
        "language": { "const": "ja" },
        "description": { "type": "string" },
        "keywords": { "type": "array", "maxItems": 7, "items": { "type": "string" } },
        "categoryPaths": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["top", "sub", "place"],
            "properties": { "top": { "type": "string" }, "sub": { "type": "string" }, "place": { "type": "string" } }
          }
        },
        "applyDrm": { "type": "boolean" },
        "aiDisclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "text", "images", "translations", "textTools", "imageTools"],
          "properties": {
            "used": { "type": "boolean" },
            "text": { "type": "string" },
            "images": { "type": "string" },
            "translations": { "type": "string" },
            "textTools": { "type": "array", "items": { "type": "string" } },
            "imageTools": { "type": "array", "items": { "type": "string" } }
          }
        },
        "blockReason": { "type": "string" },
        "priceYen": { "$ref": "common.schema.json#/$defs/yen" },
        "royaltyPlan": { "enum": [70, 35] },
        "kuEnrolled": { "type": "boolean" },
        "epubPath": { "type": "string", "pattern": "^\\.local/kindle-books/" },
        "coverPath": { "type": "string", "pattern": "^\\.local/kindle-books/" },
        "status": {
          "description": "編集上の判断 (この版を売るか)。本棚の観測は kdpStatus、作業の到達点は publicationStage。3 つの関係は listing の allOf が固定する",
          "enum": ["draft", "listed", "blocked-thin", "blocked-design", "withdrawn"]
        },
        "withdrawal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedAt", "reason"],
          "properties": {
            "requestedAt": { "$ref": "common.schema.json#/$defs/date" },
            "reason": { "type": "string" },
            "unpublishedAt": { "$ref": "common.schema.json#/$defs/datetime" },
            "unpublishedVia": { "type": "string" },
            "readBack": { "type": "string" },
            "evidence": { "type": "string" }
          }
        },
        "draftId": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "asin": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/asin" }] },
        "publishedAt": { "$ref": "#/definitions/nullableDate" },
        "lastSubmittedAt": { "$ref": "#/definitions/nullableDate" },
        "salesStartedAt": { "$ref": "#/definitions/nullableDate" },
        "kdpStatus": {
          "description": "KDP 本棚の read-back を正規化した観測 (kdp-status.mjs の normalizeKdpStatus)。観測日は kdpStatusCheckedAt",
          "enum": ["draft", "in_review", "live", "unknown"]
        },
        "kdpStatusLabel": { "$ref": "#/definitions/nullableString" },
        "kdpStatusCheckedAt": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/datetime" }] },
        "publicationStage": { "$ref": "#/definitions/publicationStage" },
        "publicationStageUpdatedAt": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/datetime" }] },
        "publicationStageEvidence": {
          "description": "工程ごとの read-back の証拠。中身は工程により異なるので at だけを必須にする",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/publicationStage" },
          "additionalProperties": {
            "type": "object",
            "required": ["at"],
            "properties": { "at": { "$ref": "common.schema.json#/$defs/datetime" } }
          }
        },
        "publicationStageLastAttempt": {
          "description": "後退する工程を試みて保持した記録 (advancePublicationStage)",
          "type": "object",
          "required": ["at", "attemptedStage", "retainedStage"],
          "properties": {
            "at": { "$ref": "common.schema.json#/$defs/datetime" },
            "attemptedStage": { "$ref": "#/definitions/publicationStage" },
            "retainedStage": { "$ref": "#/definitions/publicationStage" }
          }
        },
        "editionNumber": { "type": "integer", "minimum": 1 },
        "replacesAsin": { "$ref": "common.schema.json#/$defs/asin" },
        "supersededAt": { "$ref": "common.schema.json#/$defs/datetime" },
        "unpublishAfterReplacementLive": { "type": "boolean" },
        "unpublishedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      }
    },
    "listing": {
      "description": "status (判断)・kdpStatus (本棚の観測)・publicationStage (作業の到達点) の整合は下の allOf で固定する (2026-10-27)。書き手 (.claude/scripts/kdp/lib/kdp-status.mjs の mergeKdpOperationalState) は観測が in_review / live なら status を listed にし、publicationStage を submitted / live へ進める",
      "allOf": [
        { "$ref": "#/definitions/edition" },
        {
          "description": "販売中の観測には ASIN・販売開始日・live 以降の工程が要り、判断は listed か withdrawn (出版停止の処理待ち)",
          "if": { "required": ["kdpStatus"], "properties": { "kdpStatus": { "const": "live" } } },
          "then": {
            "required": ["asin", "salesStartedAt", "publicationStage"],
            "properties": {
              "asin": { "type": "string" },
              "salesStartedAt": { "type": "string" },
              "publicationStage": { "enum": ["live", "previous_unpublished"] },
              "status": { "enum": ["listed", "withdrawn"] }
            }
          }
        },
        {
          "description": "審査中の観測は submitted 以降の工程で、判断は listed か withdrawn",
          "if": { "required": ["kdpStatus"], "properties": { "kdpStatus": { "const": "in_review" } } },
          "then": {
            "required": ["publicationStage"],
            "properties": {
              "publicationStage": { "enum": ["submitted", "live", "previous_unpublished"] },
              "status": { "enum": ["listed", "withdrawn"] }
            }
          }
        },
        {
          "description": "listed は本棚の観測を持つ (未確認の間は unknown)。下書きの観測のままの listed は書き戻し漏れ",
          "if": { "required": ["status"], "properties": { "status": { "const": "listed" } } },
          "then": { "required": ["kdpStatus"], "properties": { "kdpStatus": { "enum": ["in_review", "live", "unknown"] } } }
        },
        {
          "description": "売らない判断 (draft・blocked-*) の版は live 以降の工程に進んでいない",
          "if": { "required": ["status"], "properties": { "status": { "enum": ["draft", "blocked-thin", "blocked-design"] } } },
          "then": { "properties": { "publicationStage": { "enum": ["prepared", "details_filled", "files_processed", "verified", "submitted"] } } }
        },
        {
          "description": "出版停止を受理した withdrawn は、本棚で下書きに戻っている",
          "if": {
            "required": ["status", "withdrawal"],
            "properties": { "status": { "const": "withdrawn" }, "withdrawal": { "required": ["unpublishedAt"] } }
          },
          "then": { "properties": { "kdpStatus": { "enum": ["draft", "unknown"] } } }
        }
      ],
      "required": ["id", "title", "priceYen", "status", "epubPath", "coverPath", "asin", "publishedAt"],
      "propertyNames": {
        "enum": [
          "id", "title", "subtitle", "author", "authorLastName", "authorFirstName", "authorKana", "authorRomaji",
          "titleKana", "titleRomaji", "subtitleKana", "subtitleRomaji", "readingSourceTitle", "readingSourceSubtitle",
          "language", "description", "keywords", "categoryPaths", "applyDrm", "aiDisclosure", "blockReason", "priceYen",
          "royaltyPlan", "kuEnrolled", "epubPath", "coverPath", "status", "withdrawal", "draftId", "asin", "publishedAt",
          "lastSubmittedAt", "salesStartedAt", "kdpStatus", "kdpStatusLabel", "kdpStatusCheckedAt", "publicationStage",
          "publicationStageUpdatedAt", "publicationStageEvidence", "publicationStageLastAttempt", "editionNumber",
          "replacesAsin", "previousEditions"
        ]
      },
      "properties": {
        "previousEditions": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/definitions/edition" }],
            "required": ["id", "title", "asin", "status"],
            "propertyNames": {
              "enum": [
                "id", "title", "subtitle", "author", "authorLastName", "authorFirstName", "authorKana", "authorRomaji",
                "titleKana", "titleRomaji", "subtitleKana", "subtitleRomaji", "readingSourceTitle", "readingSourceSubtitle",
                "language", "description", "keywords", "categoryPaths", "applyDrm", "aiDisclosure", "priceYen", "royaltyPlan",
                "kuEnrolled", "epubPath", "coverPath", "draftId", "status", "asin", "publishedAt", "salesStartedAt", "kdpStatus",
                "kdpStatusLabel", "kdpStatusCheckedAt", "supersededAt", "unpublishAfterReplacementLive", "unpublishedAt", "withdrawal"
              ]
            }
          }
        }
      }
    }
  }
}
