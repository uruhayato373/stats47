{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ココナラの期待アカウント (account assert)",
  "description": "config/coconala-account.json の形状契約。2026-10-11 に実データ 1 件から推論して作成。新しい項目は properties へ足す (additionalProperties は既定で許す)。",
  "type": "object",
  "properties": {
    "sellerName": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "profileUrl": {
      "type": "string"
    },
    "listedAt": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "approval": {
      "type": "string"
    },
    "_note": {
      "type": "string"
    }
  },
  "required": [
    "sellerName",
    "userId",
    "profileUrl",
    "listedAt",
    "approvedAt",
    "approval",
    "_note"
  ]
}
