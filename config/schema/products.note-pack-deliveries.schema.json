{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "note 有料データパックの納品物の固定値",
  "description": "data/products/note-pack-deliveries.json の形状契約。note の有料データパック (P-NN) ごとに、販売する納品版の置き場と manifest の SHA を固定する。2026-11-08 にココナラの出品台帳の _noteDelivery から移した。商品 ID が商品ファクトリーのカタログにあることは config/datasets.mjs の refs が検査する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "packs": {
      "type": "object",
      "propertyNames": { "pattern": "^P-\\d{2}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["_delivery"],
        "properties": { "_delivery": { "$ref": "#/definitions/delivery" } }
      }
    }
  },
  "definitions": {
    "delivery": {
      "description": "販売する納品版の固定 (成果物のディレクトリと manifest の SHA)",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactDirectory", "manifestSha256"],
      "properties": {
        "artifactDirectory": { "type": "string", "pattern": "^\\.local/data-packs/P-\\d{2}/[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "indicatorCount": { "type": "integer", "minimum": 0 },
        "pptxIndicatorCount": { "type": "integer", "minimum": 0 },
        "hasXlsx": { "type": "boolean" },
        "officeValidation": { "enum": ["owner-pending", "verified"] },
        "verifiedAt": { "$ref": "common.schema.json#/$defs/date" },
        "manifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "originalManifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "previewHeader": { "type": "string" },
        "labelRevision": { "type": "string" },
        "_note": { "type": "string" }
      }
    }
  }
}
