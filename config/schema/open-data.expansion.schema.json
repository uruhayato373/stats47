{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open data expansion decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasetId",
          "table",
          "slice",
          "channel",
          "status",
          "title",
          "unit",
          "aggregation",
          "reason",
          "decidedAt",
          "decidedBy"
        ],
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "table": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "areaLevel",
              "dims",
              "time",
              "dimensionAggregation",
              "timeAggregation"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "areaLevel": {
                "enum": [
                  "prefecture",
                  "municipality"
                ]
              },
              "dims": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "time": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "const": "point"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ],
                    "properties": {
                      "kind": {
                        "const": "range"
                      },
                      "start": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    }
                  }
                ]
              },
              "dimensionAggregation": {
                "enum": [
                  "none",
                  "sum"
                ]
              },
              "timeAggregation": {
                "enum": [
                  "none",
                  "sum",
                  "max"
                ]
              }
            }
          },
          "channel": {
            "enum": [
              "prefecture-ranking",
              "municipality-ranking",
              "theme",
              "area",
              "gis"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "rejected",
              "blocked"
            ]
          },
          "metricKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "aggregation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "identity",
                  "divide",
                  "per-100k"
                ]
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "denominatorTime": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "denominator": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "duplicateOf": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decidedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "decidedBy": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tableSha256",
              "rowCount",
              "areaCount",
              "min",
              "max"
            ],
            "properties": {
              "tableSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rowCount": {
                "type": "integer",
                "minimum": 1
              },
              "areaCount": {
                "type": "integer",
                "minimum": 1
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              }
            },
            "then": {
              "required": [
                "metricKey"
              ],
              "not": {
                "required": [
                  "duplicateOf"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "channel": {
                  "enum": [
                    "theme",
                    "area"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "target"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                },
                "aggregation": {
                  "properties": {
                    "type": {
                      "enum": [
                        "divide",
                        "per-100k"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "denominator"
              ],
              "properties": {
                "aggregation": {
                  "required": [
                    "denominatorTime"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
