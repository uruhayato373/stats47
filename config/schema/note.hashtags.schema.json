{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "note 記事ごとの承認済みハッシュタグ (人が判断して決める値)",
  "description": "data/note/hashtags.json の形状契約。キーは記事台帳 note.articles の記事の ID。題・URL・系統は記事台帳から結ぶので持たない。キーは記事の ID の昇順で並べる。",
  "type": "object",
  "required": ["hashtags"],
  "additionalProperties": false,
  "properties": {
    "hashtags": {
      "type": "object",
      "propertyNames": { "pattern": "^[\\w-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["tags", "sourceSha256", "model", "generatedAt"],
        "additionalProperties": false,
        "properties": {
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "model": { "type": "string", "minLength": 1 },
          "generatedAt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
