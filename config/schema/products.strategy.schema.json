{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "商品戦略の台帳",
  "description": "data/products/product-strategy.json の形状契約。商品群ごとの判断、決定の記録、次に議論する論点を人が書く。価格と実績は持たない",
  "type": "object",
  "required": ["schemaVersion", "fees", "lines", "decisions", "agenda"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "notebook": {
      "description": "戦略文書と台帳への質問に使う NotebookLM のノートブック",
      "type": "object",
      "required": ["name", "id", "use"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "ノートブックの名前" },
        "id": { "type": "string", "minLength": 1, "description": "ノートブックの ID (notebooklm ask -n に渡す)" },
        "marketingNotebookId": { "type": "string", "minLength": 1, "description": "販促用に分けたノートブックの ID" },
        "use": { "type": "string", "minLength": 1, "description": "使い方の約束" }
      }
    },
    "fees": {
      "description": "販売チャネルごとの手数料 (キーはチャネル名。note の手取りの計算に使う)",
      "type": "object",
      "required": ["note"],
      "additionalProperties": {
        "type": "object",
        "required": ["cardProcessingRate", "platformRate", "source", "checkedOn"],
        "additionalProperties": false,
        "properties": {
          "cardProcessingRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "決済手数料率 (0〜1)" },
          "platformRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "プラットフォーム手数料率 (0〜1)" },
          "source": { "type": "string", "minLength": 1, "description": "手数料率の出典 URL" },
          "checkedOn": { "type": "string", "format": "date", "description": "出典を確かめた日" }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "stance", "audience", "harm", "payReason", "priceRule", "demandEvidence", "nextReviewOn", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "stance": { "enum": ["price-test", "keep", "hold", "stop"] },
          "audience": { "type": "string", "minLength": 1 },
          "harm": { "type": "string", "minLength": 1 },
          "payReason": { "type": "string", "minLength": 1 },
          "priceRule": { "type": "string", "minLength": 1 },
          "demandEvidence": { "type": "string", "minLength": 1 },
          "nextReviewOn": { "type": "string", "format": "date" },
          "match": {
            "type": "object",
            "required": ["channel", "status"],
            "additionalProperties": false,
            "properties": {
              "channel": { "enum": ["note", "kdp"] },
              "status": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "vertical": { "type": "string" },
              "minYen": { "type": "integer" },
              "maxYen": { "type": "integer" }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "topic", "decision", "reason", "by"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "topic": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "by": { "enum": ["owner"] }
        }
      }
    },
    "agenda": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "question", "evidenceNeeded"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "evidenceNeeded": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
