{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KDP へ送った版の暗号化保全の台帳",
  "description": "data/products/kindle-archives.json の形状契約。2026-10-11 に実データ 1 件から推論して作成。新しい項目は properties へ足す (additionalProperties は既定で許す)。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "archiveFormat": {
      "type": "string"
    },
    "bucket": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "books": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "latestRevision": {
            "type": "string"
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string"
                },
                "archivedAt": {
                  "type": "string"
                },
                "verifiedAt": {
                  "type": "string"
                },
                "remotePrefix": {
                  "type": "string"
                },
                "manifestSha256": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "plainSha256": {
                        "type": "string"
                      },
                      "cipherSha256": {
                        "type": "string"
                      },
                      "plainSize": {
                        "type": "number"
                      },
                      "cipherSize": {
                        "type": "number"
                      },
                      "key": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "key"
                    ]
                  }
                },
                "version": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "archiveFormat",
    "bucket",
    "prefix",
    "generatedAt",
    "books"
  ]
}
