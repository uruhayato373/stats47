{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "事業イシューマップ",
  "description": "data/business/issue-map.json の形状契約。行と列の組み合わせ・ID の参照は apps/admin/lib/issue-map.ts の validateIssueMap が見る。判定日と進み具合の項目を持たせず、ref で台帳を指す。",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "issue", "columns", "rows", "cells", "premises", "storyline", "notes"],
  "additionalProperties": false,
  "definitions": {
    "bizId": { "type": "string", "pattern": "^biz:[a-z0-9:-]+$" },
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["improvement", "backlog", "pilot", "experiment"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["seen", "open", "unknown", "undecided"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "judgment": {
      "type": "object",
      "required": ["picture", "ref"],
      "additionalProperties": false,
      "properties": {
        "picture": { "type": "string", "minLength": 1 },
        "ref": { "oneOf": [{ "$ref": "#/definitions/ref" }, { "type": "null" }] }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string" },
    "observedAt": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "issue": {
      "type": "object",
      "required": ["id", "question", "hypothesis", "criteria"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/bizId" },
        "question": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/bizId" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "title", "question", "examples"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/bizId" },
          "title": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "examples": { "type": "string", "minLength": 1 },
          "relatedDataset": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "row", "column", "rating", "ratingLabel", "states", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/bizId" },
          "row": { "$ref": "#/definitions/bizId" },
          "column": { "$ref": "#/definitions/bizId" },
          "rating": { "enum": ["◎", "○", "△", "✕"] },
          "ratingLabel": { "type": "string", "minLength": 1 },
          "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/state" } },
          "evidence": { "type": "string", "minLength": 1 },
          "next": { "type": "string", "minLength": 1 },
          "judgments": { "type": "array", "items": { "$ref": "#/definitions/judgment" } },
          "refs": { "type": "array", "items": { "$ref": "#/definitions/ref" } }
        }
      }
    },
    "premises": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "state", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/bizId" },
          "title": { "type": "string", "minLength": 1 },
          "state": { "$ref": "#/definitions/state" },
          "evidence": { "type": "string", "minLength": 1 },
          "judgments": { "type": "array", "items": { "$ref": "#/definitions/judgment" } }
        }
      }
    },
    "storyline": {
      "type": "object",
      "required": ["steps", "summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["key", "kind", "title", "points"],
            "additionalProperties": false,
            "properties": {
              "key": { "enum": ["空", "雨", "傘"] },
              "kind": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "points": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observedAt", "text", "cells"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/bizId" },
          "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "text": { "type": "string", "minLength": 1 },
          "cells": { "type": "array", "items": { "$ref": "#/definitions/bizId" } }
        }
      }
    }
  }
}
