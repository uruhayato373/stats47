{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open data fetch recipes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipes"
  ],
  "properties": {
    "recipes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasetId",
          "fetch",
          "version"
        ],
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fetch": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "urls"
                ],
                "properties": {
                  "type": {
                    "const": "http-file"
                  },
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^https?://[^\\s]+$"
                    },
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "indexUrl",
                  "linkPattern",
                  "maxFiles"
                ],
                "properties": {
                  "type": {
                    "const": "http-index"
                  },
                  "indexUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "linkPattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxFiles": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "baseUrl",
                  "packageId",
                  "formats"
                ],
                "properties": {
                  "type": {
                    "const": "ckan"
                  },
                  "baseUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "packageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "formats": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "url",
                  "pageParam",
                  "pageSize",
                  "maxPages"
                ],
                "properties": {
                  "type": {
                    "const": "api-paged"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "pageParam": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pageSize": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxPages": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "apiKeySecret": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "reason",
                  "note"
                ],
                "properties": {
                  "type": {
                    "const": "skip"
                  },
                  "reason": {
                    "enum": [
                      "huge",
                      "web-only",
                      "tile-service",
                      "needs-api-key",
                      "terms-forbid",
                      "no-machine-access",
                      "other"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "maxLength": 100
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "default": 5368709120
          },
          "normalize": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tables"
            ],
            "properties": {
              "tables": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "table",
                    "filePattern",
                    "areas",
                    "time",
                    "aggregation",
                    "unit"
                  ],
                  "properties": {
                    "table": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "filePattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "encoding": {
                      "enum": [
                        "auto",
                        "utf-8",
                        "shift_jis"
                      ]
                    },
                    "areas": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "level",
                              "column"
                            ],
                            "properties": {
                              "level": {
                                "enum": [
                                  "national",
                                  "prefecture",
                                  "municipality",
                                  "district",
                                  "mesh",
                                  "point",
                                  "line",
                                  "polygon"
                                ]
                              },
                              "column": {
                                "type": "string",
                                "minLength": 1
                              },
                              "width": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 12
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "level",
                              "compose"
                            ],
                            "properties": {
                              "level": {
                                "enum": [
                                  "national",
                                  "prefecture",
                                  "municipality",
                                  "district",
                                  "mesh",
                                  "point",
                                  "line",
                                  "polygon"
                                ]
                              },
                              "compose": {
                                "type": "array",
                                "minItems": 2,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "column",
                                    "width"
                                  ],
                                  "properties": {
                                    "column": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "width": {
                                      "type": "integer",
                                      "minimum": 1,
                                      "maximum": 12
                                    }
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    "time": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dims": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "aggregation": {
                      "enum": [
                        "count",
                        "sum"
                      ]
                    },
                    "valueColumn": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "aggregation": {
                            "const": "sum"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "valueColumn"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
