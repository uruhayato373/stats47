{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "e-Stat 外オープンデータの提供元のマスタ",
  "description": "data/open-data/catalog/sources.json の形状契約。政府・自治体の公式の提供元だけを登録する (isOfficial は常に true)。提供元ごとのデータセット ID の一覧は持たず、読み込み口が open-data.datasets の sourceId から導く。KSJ のデータセットはここに複製せず geo.ksj-datasets を正本にする。lastVerifiedAt は実際に公式ページを開いて確認した日だけ更新する。列挙値は packages/data-configs/src/open-data-catalog/types.ts の OPEN_DATA_SOURCE_KINDS と VERIFICATION_STATUSES と同じ。読み込みは packages/data-configs/src/open-data-catalog/sources.ts。",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "publisher", "kind", "homepageUrl", "termsUrl", "isOfficial", "status", "lastVerifiedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "kebab-case の安定 ID", "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["government-portal", "government-api", "municipal-portal", "gis-portal", "dashboard"] },
          "homepageUrl": { "type": "string", "pattern": "^https://" },
          "catalogUrl": { "type": "string", "pattern": "^https://" },
          "apiDocsUrl": { "type": "string", "pattern": "^https://" },
          "termsUrl": { "type": "string", "pattern": "^https://" },
          "isOfficial": { "const": true },
          "status": { "enum": ["verified", "partially-verified", "unverified", "unavailable", "deprecated"] },
          "lastVerifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "description": "UI は継続・API は終了のような状態差と注意事項", "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
