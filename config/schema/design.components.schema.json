{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "部品の台帳",
  "description": "data/design/components.json の形状契約 (2026-10-29 作成)。部品の種類 1 つにつき、役割・正典の実装・枠 (slot)・寸法の仕様・見本の採用元・使わない場面・守らせる検査を持つ。どのページで使っているかはコードから数えるので持たない。",
  "type": "object",
  "required": ["components"],
  "additionalProperties": false,
  "properties": {
    "_doc": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["id", "name", "role", "implementation", "slots", "spec", "useWhen", "avoidWhen", "checks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "部品の種類の ID (kebab-case)。avoidWhen[].use から参照する" },
        "name": { "type": "string", "minLength": 1, "description": "部品の種類の日本語名 (docs と references.json の adoptions[].part と同じ語)" },
        "role": { "type": "string", "minLength": 10, "description": "何を見せる部品か" },
        "implementation": {
          "type": "object",
          "required": ["package", "export", "source"],
          "additionalProperties": false,
          "properties": {
            "package": { "type": "string", "pattern": "^@stats47/" },
            "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "source": { "type": "string", "pattern": "^packages/.+\\.tsx$" },
            "propsType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "description": "props の型名。source の中で interface として宣言されていること" }
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["prop", "required", "what"],
            "additionalProperties": false,
            "properties": {
              "prop": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
              "required": { "type": "boolean" },
              "what": { "type": "string", "minLength": 1 }
            }
          }
        },
        "spec": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "寸法の仕様 (要素名 → 値)。値の正本は見本の実測で、ここはその写しではなく部品が守る約束"
        },
        "reference": {
          "type": "object",
          "required": ["referenceId", "adoptionPart"],
          "additionalProperties": false,
          "properties": {
            "referenceId": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "data/design-references/references.json の references[].id" },
            "adoptionPart": { "type": "string", "minLength": 1, "description": "その参考サイトの adoptions[].part" }
          }
        },
        "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "avoidWhen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "use"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "use": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "代わりに使う部品の id" }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "apps/web/scripts/check-design-system.mjs の規則 id" }
        }
      }
    }
  }
}
