{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "港湾のマスタ",
  "description": "data/areas/master/ports.json の形状契約。港湾 (699 件)。portCode は 5 桁、prefectureCode は JIS X 0401 の 2 桁 (都道府県のマスタの prefCode の先頭 2 桁)。latitude・longitude・portGrade・administrator は記録に値の無い行が null。読み込みは packages/database/src/utils/area-master.ts。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["portCode", "portName", "prefectureCode", "prefectureName", "latitude", "longitude", "portGrade", "administrator"],
    "additionalProperties": false,
    "properties": {
      "portCode": { "type": "string", "pattern": "^\\d{5}$" },
      "portName": { "type": "string", "minLength": 1 },
      "prefectureCode": { "type": "string", "pattern": "^\\d{2}$" },
      "prefectureName": { "type": "string", "minLength": 1 },
      "latitude": { "type": ["number", "null"] },
      "longitude": { "type": ["number", "null"] },
      "portGrade": { "enum": ["国際戦略港湾", "国際拠点港湾", "重要港湾", null] },
      "administrator": { "type": ["string", "null"] }
    }
  }
}
