{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productId",
    "articleKey",
    "displayTitle",
    "description",
    "useCases",
    "examples",
    "purchaseNotes",
    "analysisPlan"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "articleKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "displayTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "useCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "lead",
          "metricKeys",
          "preferredTemplate",
          "themeRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "lead": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metricKeys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "preferredTemplate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "themeRefs": {
            "$ref": "#/$defs/themeRefs"
          }
        }
      }
    },
    "purchaseNotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "analysisRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "title",
        "description",
        "useCases",
        "sources",
        "research",
        "recipes",
        "notes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "useCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "grain",
              "years",
              "inputs",
              "definition",
              "boundary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "grain": {
                "enum": [
                  "prefecture",
                  "municipality",
                  "capital-city"
                ]
              },
              "years": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                }
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metricKey"
                  ],
                  "properties": {
                    "metricKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "variantId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "references"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "url",
                  "section",
                  "finding",
                  "checkedAt"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          }
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "heading",
              "lead",
              "sourceId",
              "metricIds",
              "method",
              "template",
              "references",
              "limitation",
              "themeRefs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "lead": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "metricIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "method": {
                "enum": [
                  "index",
                  "share",
                  "series",
                  "balance",
                  "change",
                  "compare",
                  "ratio",
                  "composition"
                ]
              },
              "areaCode": {
                "type": "string",
                "pattern": "^\\d{5}$"
              },
              "denominatorId": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "integer"
              },
              "to": {
                "type": "integer"
              },
              "template": {
                "enum": [
                  "line",
                  "bar",
                  "choropleth",
                  "stacked-bar"
                ]
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              },
              "balances": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "positiveId",
                    "negativeId"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "positiveId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "negativeId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "presentationMetricKey": {
                "type": "string",
                "minLength": 1
              },
              "chartTitle": {
                "type": "string",
                "minLength": 1
              },
              "scopeLabel": {
                "type": "string",
                "minLength": 1
              },
              "areaCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{5}$"
                }
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "within": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "nation"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "prefCode"
                    ],
                    "properties": {
                      "kind": {
                        "const": "prefecture"
                      },
                      "prefCode": {
                        "type": "string",
                        "pattern": "^(0[1-9]|[1-3][0-9]|4[0-7])$"
                      }
                    }
                  }
                ]
              },
              "themeRefs": {
                "$ref": "#/$defs/themeRefs"
              },
              "remainder": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "template": {
                      "const": "choropleth"
                    }
                  },
                  "required": [
                    "template"
                  ]
                },
                "then": {
                  "required": [
                    "within",
                    "presentationMetricKey"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "areaCode"
                        ]
                      },
                      {
                        "required": [
                          "areaCodes"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "analysisPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "inputs",
        "analysisRefs",
        "figureRefs",
        "reuseProducts",
        "limitations",
        "axes"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metricKey",
              "scope",
              "decision",
              "reason"
            ],
            "properties": {
              "metricKey": {
                "type": "string",
                "minLength": 1
              },
              "variantId": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "prefecture",
                  "municipality",
                  "capital-city"
                ]
              },
              "decision": {
                "enum": [
                  "use",
                  "investigate",
                  "exclude"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "analysisRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figureRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reuseProducts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "axis",
              "decision",
              "reason",
              "recipeRefs"
            ],
            "properties": {
              "axis": {
                "enum": [
                  "trend",
                  "composition",
                  "comparison"
                ]
              },
              "decision": {
                "enum": [
                  "required",
                  "deferred",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "recipeRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "analysisReuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "title",
        "description",
        "useCases",
        "notes",
        "format",
        "examples"
      ],
      "properties": {
        "version": {
          "$ref": "#/properties/analysisRevision/properties/version"
        },
        "title": {
          "$ref": "#/properties/analysisRevision/properties/title"
        },
        "description": {
          "$ref": "#/properties/analysisRevision/properties/description"
        },
        "useCases": {
          "$ref": "#/properties/analysisRevision/properties/useCases"
        },
        "notes": {
          "$ref": "#/properties/analysisRevision/properties/notes"
        },
        "format": {
          "enum": [
            "figures",
            "packs"
          ]
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productId",
              "version",
              "recipeId"
            ],
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "$ref": "#/properties/analysisRevision/properties/version"
              },
              "recipeId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "themeRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "themeKey",
          "sectionKey"
        ],
        "properties": {
          "themeKey": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "sectionKey": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  },
  "not": {
    "required": [
      "analysisRevision",
      "analysisReuse"
    ]
  }
}
