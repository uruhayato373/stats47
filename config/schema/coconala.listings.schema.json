{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ココナラの出品内容と公開状態",
  "description": "config/coconala-listings.json の形状契約。2026-10-11 に実データ 1 件から推論して作成。新しい項目は properties へ足す (additionalProperties は既定で許す)。",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    },
    "_schema": {
      "type": "object",
      "properties": {
        "<PRODUCT_ID>": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "priceYen": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "serviceUrl": {
              "type": "string"
            },
            "listedAt": {
              "type": "string"
            },
            "catchphrase": {
              "type": "string"
            },
            "category": {
              "type": "object",
              "properties": {
                "master": {
                  "type": "string"
                },
                "sub": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            "genreFacets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provisionFormat": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "purchaseNote": {
              "type": "string"
            },
            "deliveryDays": {
              "type": "string"
            },
            "fixLimit": {
              "type": "string"
            },
            "faq": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string"
                  },
                  "a": {
                    "type": "string"
                  }
                }
              }
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "priceYen": {
                    "type": "number"
                  },
                  "deliveryDays": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "listings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "priceYen": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "serviceUrl": {
            "type": "string"
          },
          "draftId": {
            "type": "string"
          },
          "_thumbnail": {
            "type": "string"
          },
          "_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sellerUserId": {
            "type": "string"
          },
          "catchphrase": {
            "type": "string"
          },
          "category": {
            "type": "object",
            "properties": {
              "master": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "genreFacets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provisionFormat": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "body": {
            "type": "string"
          },
          "purchaseNote": {
            "type": "string"
          },
          "deliveryDays": {
            "type": "number"
          },
          "fixLimit": {
            "type": "string"
          },
          "faq": {
            "type": "array"
          },
          "options": {
            "type": "array"
          },
          "_source": {
            "type": "string"
          },
          "_approval": {
            "type": "string"
          },
          "_sampleArchiveSha256": {
            "type": "string"
          },
          "listedAt": {
            "type": "string"
          },
          "_thumbnailNote": {
            "type": "string"
          },
          "_delivery": {
            "type": "object",
            "properties": {
              "artifactDirectory": {
                "type": "string"
              },
              "indicatorCount": {
                "type": "number"
              },
              "pptxIndicatorCount": {
                "type": "number"
              },
              "hasXlsx": {
                "type": "boolean"
              },
              "officeValidation": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string"
              },
              "manifestSha256": {
                "type": "string"
              },
              "previewHeader": {
                "type": "string"
              },
              "labelRevision": {
                "type": "string"
              },
              "originalManifestSha256": {
                "type": "string"
              }
            }
          },
          "_provisionFormatNote": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "_note",
    "_schema",
    "listings"
  ]
}
