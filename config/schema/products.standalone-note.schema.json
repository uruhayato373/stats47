{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "articleKey",
          "licenseId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "articleKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "licenseId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
