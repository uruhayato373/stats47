{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI 画像の生成経路",
  "description": "config/image-generation-routes.json の形状契約。検査は .claude/scripts/lib/check-image-generation-routes.mjs。",
  "type": "object",
  "required": ["schemaVersion", "routes", "deterministicRoutes", "legacy"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataNote": { "type": "string" },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "generator", "invoke", "entry", "master", "record"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "generator": { "const": "codex-imagegen" },
          "invoke": { "enum": ["mcp", "owner-session"] },
          "entry": { "type": "string" },
          "master": { "type": "string" },
          "record": { "type": "string" }
        }
      }
    },
    "deterministicRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "entry", "note"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "entry": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "legacy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "removalCard", "reason"],
        "additionalProperties": false,
        "properties": { "path": { "type": "string" }, "removalCard": { "type": "string", "pattern": "^[A-Z0-9-]+$" }, "reason": { "type": "string" } }
      }
    }
  }
}
