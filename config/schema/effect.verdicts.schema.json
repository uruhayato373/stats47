{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "改善施策の効果判定 (閾値エンジン)",
  "description": "週次の効果判定と原本hashに結んだappend-only再評価。assessmentはbaseline観測と効果実験を分離する。過去のassessment無し記録は維持する。 書き手 (packages/ops/src/effect-verdict/cli.mjs の runAdapter と engine.mjs の decideVerdict) が決まった項目だけを書くオブジェクトは閉じる (additionalProperties: false。2026-11-22)。件数の集計 (byLabel / byGuard) はラベル・ガードの名前をキーにした辞書なので閉じない。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "week": {
      "type": "string"
    },
    "decidedAt": {
      "type": "string"
    },
    "thresholdsVersion": {
      "type": "string"
    },
    "thresholdsPath": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "byLabel": {
          "type": "object",
          "properties": {
            "effect/pending": {
              "type": "number"
            }
          },
          "description": "effect ラベルごとの件数 (キーはラベル)",
          "additionalProperties": {
            "type": "number"
          }
        },
        "byGuard": {
          "type": "object",
          "properties": {
            "insufficient-target": {
              "type": "number"
            },
            "insufficient-sample": {
              "type": "number"
            },
            "confounded": {
              "type": "number"
            },
            "insufficient-window": {
              "type": "number"
            }
          },
          "description": "ガードごとの hit 件数 (キーはガードの code)",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domainId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "thresholdsVersion": {
            "type": "string"
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "before": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "impressions": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "after": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "impressions": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "relativeDelta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {},
          "attainment": {},
          "boundaries": {
            "type": "object",
            "properties": {
              "attainmentFull": {
                "type": "number"
              },
              "attainmentPartial": {
                "type": "number"
              },
              "adverseRelativeDrop": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "window": {
            "type": "object",
            "properties": {
              "beforeWeek": {
                "description": "比べる前の週。施策のデプロイ週が無いとき (notDue) は adapter が null を返す (ga4-improvements-adapter.mjs・gsc-improvements-adapter.mjs)",
                "type": ["string", "null"]
              },
              "afterWeek": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "elapsedWeeks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "notDue": {
                "type": "boolean"
              },
              "minWeeks": {
                "type": "number"
              },
              "weeks": {
                "description": "baseline 観測で揃える週 (assessment.weeks の写し)",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reviewDate": {
                "description": "baseline 観測の期限 (assessment.reviewDate の写し)",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "判定窓。効果実験は beforeWeek / afterWeek / elapsedWeeks (+ engine が minWeeks、adapter が notDue) を、baseline 観測は weeks / reviewDate を持つ"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                },
                "freshness": {
                  "type": "string"
                },
                "accountId": {
                  "description": "baseline 観測で照合する口座 ID",
                  "type": "string"
                },
                "firstWeek": {
                  "description": "baseline 観測で数え始める週",
                  "type": "string"
                },
                "identityBasis": {
                  "description": "同じ口座の記録と見なす根拠",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "confounders": {
            "type": "object",
            "properties": {
              "coDeployed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "laterContaminators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "pastEffectKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "logPath": {
            "type": "string"
          },
          "reproduceCommand": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean"
          },
          "assessment": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "effect-experiment"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "subjectId",
                  "domainId",
                  "accountId",
                  "deployWeek",
                  "firstWeek",
                  "weeks",
                  "reviewDate"
                ],
                "properties": {
                  "kind": {
                    "const": "baseline-observation"
                  },
                  "subjectId": {
                    "type": "string"
                  },
                  "domainId": {
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "deployWeek": {
                    "type": "string"
                  },
                  "firstWeek": {
                    "type": "string"
                  },
                  "weeks": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "observation": {
            "description": "baseline 観測の充足 (adsense-measurement-contract.mjs の observeAdsenseBaseline が返す)。baseline-observation の verdict だけが持つ",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "observedWeeks",
              "missingWeeks",
              "overdue"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "ready"
                ],
                "description": "揃っていない週があれば pending"
              },
              "observedWeeks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "記録が揃った週"
              },
              "missingWeeks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "記録が欠けた週"
              },
              "overdue": {
                "type": "boolean",
                "description": "期限を過ぎても欠けた週が残っているか"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "assessment"
              ],
              "properties": {
                "assessment": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "baseline-observation"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "before",
                "after",
                "delta",
                "target",
                "attainment"
              ],
              "properties": {
                "label": {
                  "const": "effect/pending"
                },
                "before": {
                  "type": "null"
                },
                "after": {
                  "type": "null"
                },
                "delta": {
                  "type": "null"
                },
                "target": {
                  "type": "null"
                },
                "attainment": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "assessmentContractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "reassesses": {
      "type": "object",
      "required": [
        "week",
        "sourceSha256",
        "sourceDecidedAt"
      ],
      "properties": {
        "week": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceDecidedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "week",
    "decidedAt",
    "thresholdsVersion",
    "thresholdsPath",
    "note",
    "summary",
    "verdicts"
  ],
  "additionalProperties": false
}
