{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "改善施策の効果判定 (閾値エンジン)",
  "description": "週次の効果判定と原本hashに結んだappend-only再評価。assessmentはbaseline観測と効果実験を分離する。過去のassessment無し記録は維持する。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "week": {
      "type": "string"
    },
    "decidedAt": {
      "type": "string"
    },
    "thresholdsVersion": {
      "type": "string"
    },
    "thresholdsPath": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "byLabel": {
          "type": "object",
          "properties": {
            "effect/pending": {
              "type": "number"
            }
          }
        },
        "byGuard": {
          "type": "object",
          "properties": {
            "insufficient-target": {
              "type": "number"
            },
            "insufficient-sample": {
              "type": "number"
            },
            "confounded": {
              "type": "number"
            }
          }
        }
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domainId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "thresholdsVersion": {
            "type": "string"
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "before": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "impressions": {
                "type": "number"
              }
            }
          },
          "after": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "impressions": {
                "type": "number"
              }
            }
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "relativeDelta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {},
          "attainment": {},
          "boundaries": {
            "type": "object",
            "properties": {
              "attainmentFull": {
                "type": "number"
              },
              "attainmentPartial": {
                "type": "number"
              },
              "adverseRelativeDrop": {
                "type": "number"
              }
            }
          },
          "window": {
            "type": "object",
            "properties": {
              "beforeWeek": {
                "type": "string"
              },
              "afterWeek": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "elapsedWeeks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "notDue": {
                "type": "boolean"
              },
              "minWeeks": {
                "type": "number"
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                },
                "freshness": {
                  "type": "string"
                }
              }
            }
          },
          "confounders": {
            "type": "object",
            "properties": {
              "coDeployed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "laterContaminators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "pastEffectKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "logPath": {
            "type": "string"
          },
          "reproduceCommand": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean"
          },
          "assessment": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "effect-experiment"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "subjectId",
                  "domainId",
                  "accountId",
                  "deployWeek",
                  "firstWeek",
                  "weeks",
                  "reviewDate"
                ],
                "properties": {
                  "kind": {
                    "const": "baseline-observation"
                  },
                  "subjectId": {
                    "type": "string"
                  },
                  "domainId": {
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "deployWeek": {
                    "type": "string"
                  },
                  "firstWeek": {
                    "type": "string"
                  },
                  "weeks": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "assessment"
              ],
              "properties": {
                "assessment": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "baseline-observation"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "before",
                "after",
                "delta",
                "target",
                "attainment"
              ],
              "properties": {
                "label": {
                  "const": "effect/pending"
                },
                "before": {
                  "type": "null"
                },
                "after": {
                  "type": "null"
                },
                "delta": {
                  "type": "null"
                },
                "target": {
                  "type": "null"
                },
                "attainment": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "assessmentContractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "reassesses": {
      "type": "object",
      "required": [
        "week",
        "sourceSha256",
        "sourceDecidedAt"
      ],
      "properties": {
        "week": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceDecidedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "week",
    "decidedAt",
    "thresholdsVersion",
    "thresholdsPath",
    "note",
    "summary",
    "verdicts"
  ]
}
