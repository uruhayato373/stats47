{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 47,
  "maxItems": 47,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prefectureCode",
      "name",
      "estatAreaCode"
    ],
    "properties": {
      "prefectureCode": {
        "type": "string",
        "pattern": "^[0-9]{2}000$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "estatAreaCode": {
        "type": "string",
        "pattern": "^[0-9]{5}$"
      }
    }
  }
}
