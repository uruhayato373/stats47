{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "事業計画の見出し",
  "description": "data/business-plan/plan/catalog.json の形状契約。事業計画 (BUSINESS_PLAN_2026) の ID・版・取り込んだ原本の記録・ビジョン・標語・原則・収益の層・重点テーマ。文書・決定・指標・施策などの一覧は data/business-plan/plan/ の別の台帳に置く。読み込み口は packages/data-configs/src/business-plan/catalog.ts (BUSINESS_PLAN_2026)。",
  "type": "object",
  "required": ["id", "version", "source", "vision", "tagline", "principles", "revenueLayers", "priorityThemes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "description": "YYYY-MM-DD.N", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "source": {
      "description": "取り込んだ外部の事業計画書の記録 (原本はローカルの参考資料で、リポジトリには置かない)",
      "type": "object",
      "required": ["title", "subtitle", "sourcePath", "sourceSha256", "sourcePages", "sourceCheckedAt", "planPeriod", "note"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourcePages": { "type": "integer", "minimum": 1 },
        "sourceCheckedAt": { "type": "string", "format": "date" },
        "planPeriod": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "vision": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1 },
    "principles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "revenueLayers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "priorityThemes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
