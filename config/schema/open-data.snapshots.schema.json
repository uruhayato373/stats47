{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open data source snapshots",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "versions"
  ],
  "properties": {
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "versions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "datasetId",
          "version",
          "sha256",
          "recipeSha256",
          "retrievedAt",
          "license",
          "files",
          "manifestKey",
          "manifestSha256",
          "bytes",
          "status"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "maxLength": 100
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recipeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "license": {
            "type": "object",
            "required": [
              "name",
              "commercialUse",
              "attributionRequired",
              "modificationNoticeRequired",
              "termsUrl"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "commercialUse": {
                "enum": [
                  "allowed",
                  "restricted",
                  "unknown"
                ]
              },
              "attributionRequired": {
                "type": "boolean"
              },
              "modificationNoticeRequired": {
                "type": "boolean"
              },
              "termsUrl": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "url",
                "sha256",
                "bytes",
                "contentType",
                "retrievedAt"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^open-data/raw/[a-z0-9-]+/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://[^\\s]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "contentType": {
                  "type": "string",
                  "minLength": 1
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "manifestKey": {
            "type": "string",
            "pattern": "^open-data/raw/[a-z0-9-]+/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "staged",
              "archived"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "datasetId",
        "version",
        "sha256",
        "recipeSha256",
        "retrievedAt",
        "license",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 100
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "type": "object",
          "required": [
            "name",
            "commercialUse",
            "attributionRequired",
            "modificationNoticeRequired",
            "termsUrl"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "commercialUse": {
              "enum": [
                "allowed",
                "restricted",
                "unknown"
              ]
            },
            "attributionRequired": {
              "type": "boolean"
            },
            "modificationNoticeRequired": {
              "type": "boolean"
            },
            "termsUrl": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "url",
              "sha256",
              "bytes",
              "contentType",
              "retrievedAt"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^open-data/raw/[a-z0-9-]+/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "contentType": {
                "type": "string",
                "minLength": 1
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
