{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "事業計画の行動イベント",
  "description": "data/business-plan/plan/events.json の形状契約。事業計画が測る行動イベントと、その計測状況 (並びが表示順)。canonicalEvent は GA4 のイベント名 (未実装は null)、implementationPath は実装の場所、owner は担当 agent。イベント名と GA4 の登録の正典は .claude/rules/analytics-event-standards.md。読み込み口は packages/data-configs/src/business-plan/catalog.ts (BUSINESS_PLAN_EVENTS)。",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "canonicalEvent", "status", "owner", "implementationPath", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "canonicalEvent": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
          "status": { "enum": ["measured", "partially-measured", "not-instrumented", "manual"] },
          "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "implementationPath": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
