{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "全国値を都道府県から導く指標の採否",
  "description": "data/themes/japan/derived-metric-decisions.json の形状契約。2026-08-28 に棚卸しした unknown-non-estat 9 候補に対する恒久判断 (以後に足した採否を含む)。採用は、同一年・同単位の 47 都道府県行が全国を重複なく覆い、加算が指標の意味を保つものだけ (availability.status = derived-additive)。率・指数・1 世帯当たり値は県値を合成せず、分子・分母の全国系列が欠ける計算型も unsupported に固定する (verdict = rejected)。adopted は sourceMetricKey の app/stats/<sourceMetricKey>/values.json を recipe の入力にする。metricKey と sourceMetricKey は指標のキー、themeKey は ThemeCatalog のキー。読み込み口は packages/data-configs/src/geo-scope/japan-derived-metrics.ts。",
  "type": "object",
  "required": ["decisions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metricKey", "themeKey", "verdict", "availability", "observedAt", "evidence"],
        "additionalProperties": false,
        "properties": {
          "metricKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "themeKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "verdict": { "enum": ["adopted", "rejected"] },
          "availability": { "type": "object" },
          "sourceMetricKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "adopted" } } },
            "then": {
              "required": ["sourceMetricKey"],
              "properties": {
                "availability": {
                  "required": ["status", "recipeKey"],
                  "additionalProperties": false,
                  "properties": {
                    "status": { "enum": ["derived-additive", "derived-ratio"] },
                    "recipeKey": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "else": {
              "not": { "required": ["sourceMetricKey"] },
              "properties": {
                "availability": {
                  "required": ["status", "reason"],
                  "additionalProperties": false,
                  "properties": {
                    "status": { "const": "unsupported" },
                    "reason": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
