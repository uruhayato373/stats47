{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "都道府県の公式統計ポータルの台帳",
  "description": "data/open-data/prefecture-statistics/resources.json の形状契約。県が公式に公開する統計ポータル・ダッシュボード・オープンデータ・統計年鑑のリンク。1 県に複数の資料を登録できる。県名は持たず、読み込み口が prefectureCode から県のマスタで結ぶ。県公式のドメイン、または県公式ページからリンクされた県発行の外部 BI だけを登録し、委託事業者の紹介や推測した URL を isOfficial にしない。lastVerifiedAt は実際に URL か内容を確認した日だけ更新する。列挙値は packages/data-configs/src/prefecture-statistics-catalog/types.ts と同じ。読み込みは packages/data-configs/src/prefecture-statistics-catalog/index.ts。",
  "type": "object",
  "required": ["resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prefectureCode", "title", "url", "type", "topics", "publisher", "isOfficial", "discoveredFrom", "lastVerifiedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "<都道府県コード>-<用途>。リンクの移転時も維持する", "type": "string", "pattern": "^\\d{2}-[a-z][a-z0-9-]*$" },
          "prefectureCode": { "description": "JIS X 0401 の 2 桁コード", "type": "string", "pattern": "^\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "type": { "enum": ["statistics-portal", "dashboard", "open-data-portal", "statistical-yearbook", "policy-dashboard"] },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "general", "population", "economy", "labor", "industry", "agriculture", "tourism", "healthcare", "welfare",
                "education", "environment", "disaster-prevention", "local-finance", "regional-revitalization"
              ]
            }
          },
          "publisher": { "type": "string", "minLength": 1 },
          "isOfficial": { "const": true },
          "discoveredFrom": { "description": "公式性を確認した発見元の URL。外部ドメインの場合は発行主体が県であることを示すもの", "type": "string", "pattern": "^https://" },
          "lastVerifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
