{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/world (国際比較) のテーマのマスタ",
  "description": "data/open-data/world/catalogs.json の形状契約。themes のキーがテーマの slug。意図的に空で、1 件でも足す前に対象指標の日本の行を実際に取得して値のレベルで確かめる (推測で埋めない)。空でない間だけ /world の経路・middleware・sitemap を足してよい (空のカタログの経路を先に公開すると内容が薄くなる)。読み込みは packages/data-configs/src/geo-scope/world-types.ts。",
  "type": "object",
  "required": ["themes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "themes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["themeSlug", "title", "description", "keywords", "metrics"],
        "additionalProperties": false,
        "properties": {
          "themeSlug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metricKey", "shortLabel"],
              "additionalProperties": false,
              "properties": {
                "metricKey": { "type": "string", "minLength": 1 },
                "shortLabel": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
