{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "アフィリエイトの直貼り配置の台帳",
  "description": "data/affiliate/ledger/direct-placements.json の形状契約。直接属性方式 (direct-attribute) の配置、つまり記事本文に <affiliate-banner> (ブログ) または生の HTML (note) を直書きした広告の台帳。タグベースの自動配置 (affiliate.ads → R2 app/affiliate-ads/all.json) とは別系統で、アプリと R2 の配信はこの台帳を読まない (広告の実体は各記事の本文に埋まっている)。台帳の役割は監査で、孤立した配置 (記事の削除・タグの欠落)・PR 表記の漏れ・リンクの不一致を audit-affiliate-compliance.ts が検出する。rewardNote と conversionCondition は ASP の管理画面を参照する場合 null。notes は配置 ID ごとの判断の記録。読み込み口は apps/web/scripts/affiliate-direct-placements-data.ts (AFFILIATE_DIRECT_PLACEMENTS)。",
  "type": "object",
  "required": ["placements"],
  "additionalProperties": false,
  "properties": {
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "asp", "title", "href", "imageUrl", "trackingPixelUrl", "width", "height", "rewardNote", "conversionCondition", "placements", "addedAt", "isActive"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "asp": { "enum": ["a8", "moshimo", "rakuten", "valuecommerce"] },
          "title": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "pattern": "^https://" },
          "imageUrl": { "type": "string", "pattern": "^https://" },
          "trackingPixelUrl": { "type": ["string", "null"], "pattern": "^https://" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "rewardNote": { "description": "報酬のメモ (例 ¥15,000/件)", "type": ["string", "null"] },
          "conversionCondition": { "description": "成果の条件", "type": ["string", "null"] },
          "placements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["channel", "slug", "position"],
              "additionalProperties": false,
              "properties": {
                "channel": { "enum": ["blog", "note"] },
                "slug": { "description": "ブログは blog.articles の slug、note は note.articles の key", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "position": { "description": "配置位置の説明", "type": "string", "minLength": 1 }
              }
            }
          },
          "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "notes": {
      "description": "配置 ID ごとの判断の記録",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    }
  }
}
