{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "論点レンズと白書・報告書の出典 (テーマの evidenceTopics が lensKey・sourceKeys で指す)",
  "description": "data/themes/viewpoints/evidence-lenses.json の形状契約。lenses のキーが lensKey、sources のキーが sourceKeys の ID になる。",
  "type": "object",
  "required": ["lenses", "sources"],
  "additionalProperties": false,
  "properties": {
    "lenses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "description"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "title", "publisher", "sourceUrl"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["whitepaper", "report", "statistical-overview"] },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "notebookName": { "type": "string" },
          "notebookId": { "type": "string" },
          "inventorySlug": { "type": "string" }
        }
      }
    }
  }
}
