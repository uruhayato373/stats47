{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "環境変数の名前と公開の区分の登録表",
  "description": "config/env-registry.json の形状契約 (2026-11-14 に .claude/config/ から移したときに作成)。値は置かない。visibility の語彙は .claude/scripts/lib/check-env-registry.cjs の VALID_VISIBILITY と同じ。",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "description": { "type": "string" },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "visibility": { "enum": ["public", "server", "secret", "workflow"] },
          "contexts": { "type": "array", "items": { "enum": ["process", "secret", "variable"] } },
          "note": { "type": "string" }
        },
        "required": ["name", "visibility"]
      }
    }
  },
  "required": ["version", "variables"]
}
