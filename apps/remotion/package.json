{
  "name": "stats47-remotion",
  "version": "1.0.0",
  "scripts": {
    "start": "remotion studio --port 3002",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts RankingShort out/video.mp4",
    "prepare-data": "tsx scripts/export-d1-to-remotion-static.ts --feature all",
    "pipeline:sns": "tsx scripts/pipeline/render-sns-all.ts",
    "pipeline:bar-chart-race": "tsx scripts/pipeline/render-bar-chart-race.ts",
    "pipeline:migration-flow": "tsx scripts/pipeline/render-migration-flow.ts",
    "render:business-plan-m1-x-geo": "tsx scripts/pipeline/render-business-plan-m1-x-geo.ts",
    "audit:business-plan-m1-x-geo": "tsx scripts/pipeline/audit-business-plan-m1-x-geo.ts",
    "test:geo-x-layout": "vitest run --config vitest.config.mts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@stats47/area": "*",
    "@stats47/migration-flow": "*",
    "@stats47/ranking": "*",
    "@stats47/station-passengers": "*",
    "@stats47/types": "*",
    "@stats47/utils": "*",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.0",
    "d3-geo": "^3.1.0",
    "d3-scale": "^4.0.0",
    "d3-scale-chromatic": "^3.1.0",
    "dotenv": "^17.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.517",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.2.2",
    "topojson-client": "^3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.517",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.0",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/react": "^19.0.0",
    "@types/topojson-client": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
