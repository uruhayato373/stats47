# ==============================================================================
# ローカル開発用の公開デフォルト (コミット済み・git tracked)
# ==============================================================================
# このファイルは Next.js が NODE_ENV=development (`next dev`) のときだけ自動ロードする。
# 本番ビルド (`next build` / deploy-workers.yml の wrangler deploy) は読み込まないため、
# 本番値は wrangler.toml [env.production.vars] が SSOT (ここは触らない)。
#
# 目的: cloud / 新規 checkout で `.env.local` が無くても `npm run dev` / validate-env が通る。
# ここに置けるのは「公開済みの値」だけ (NEXT_PUBLIC_* はクライアントバンドルに同梱 = 既に公開)。
# 秘匿値 (CLOUDFLARE_API_TOKEN / R2 鍵 / RAKUTEN_APP_ID 等) は絶対にここへ書かない → .env.local。
# ==============================================================================

# サイトのベースURL (メタデータ・OGP・構造化データ)。dev は localhost、本番は wrangler.toml。
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# e-Stat API アプリケーションID (公開ID)
NEXT_PUBLIC_ESTAT_APP_ID=59eb12e8a25751dfc27f2e48fcdfa8600b86655e

# R2 公開配信ドメイン (画像等)
NEXT_PUBLIC_R2_PUBLIC_URL=https://storage.stats47.jp

# ローカル開発のサーバー側データ読取用 (blog/ranking snapshots 等)
R2_PUBLIC_FETCH_URL=https://storage.stats47.jp

# 楽天アフィリエイトID (ふるさと納税リンク生成・公開値)
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=51387969.9936dd74.5138796a.70fcd579

# Google AdSense クライアントID (公開値)。ENABLED は未設定 = ローカルでは広告無効。
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-7995274743017484
