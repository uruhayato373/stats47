{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx scripts/validate-env.ts && npx tsx scripts/dev-server.ts",
    "build": "npx tsx scripts/validate-env.ts && npx cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "build:production": "npx tsx scripts/validate-env.ts && npx cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" NODE_ENV=production NEXT_PUBLIC_ENV=production next build",
    "lint": "next lint",
    "design-system:check": "node scripts/check-design-system.mjs",
    "knip": "cd ../.. && npm run knip -- --workspace apps/web",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:stats-data": "vitest run --dir ../../packages/estat-api/src/stats-data/__tests__",
    "test:ai-content": "vitest run --dir ../../packages/ai-content/src/services/__tests__",
    "test:stats-data:save-outputs": "npx cross-env SAVE_TEST_OUTPUTS=true vitest run src/features/estat-api/stats-data",
    "test:stats-data:watch": "npx cross-env SAVE_TEST_OUTPUTS=true vitest watch src/features/estat-api/stats-data",
    "test:analyze": "npx tsx scripts/analyze-coverage.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "npx tsx scripts/smoke-test.ts",
    "test:smoke:local": "npx tsx scripts/smoke-test.ts --base-url http://localhost:3000",
    "test:smoke:playwright": "playwright test --config playwright.smoke.config.ts",
    "type-check": "npx cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit --skipLibCheck",
    "generate:search-index": "npx cross-env NODE_ENV=development NODE_OPTIONS=\"--conditions react-server\" npx tsx scripts/generate-search-index.ts",
    "prebuild": "npx cross-env NODE_ENV=development NODE_OPTIONS=\"--conditions react-server\" npx tsx scripts/generate-search-index.ts",
    "workers:clean": "rimraf .next .open-next",
    "workers:prebuild": "npm run workers:clean",
    "workers:build": "npm run workers:prebuild && npx cross-env CLOUDFLARE_WORKERS=true npx tsx scripts/validate-env.ts && npx cross-env CLOUDFLARE_WORKERS=true opennextjs-cloudflare build --workers-runtime",
    "workers:preview": "opennextjs-cloudflare preview",
    "workers:populate-cache:production": "opennextjs-cloudflare populateCache remote --env production",
    "workers:deploy:production": "npm run workers:populate-cache:production && wrangler deploy --env production",
    "generate:runtime-summaries": "npx tsx scripts/generate-runtime-metric-summaries.ts",
    "check:runtime-summaries": "npx tsx scripts/generate-runtime-metric-summaries.ts --check",
    "generate:ranking-prominence": "npx tsx scripts/generate-ranking-prominence.ts",
    "check:ranking-prominence": "npx tsx scripts/generate-ranking-prominence.ts --check",
    "audit:ranking-hooks": "npx tsx scripts/generate-ranking-prominence.ts --audit",
    "generate:product-storefront": "npx tsx scripts/generate-product-storefront.ts",
    "check:product-storefront": "npx tsx scripts/generate-product-storefront.ts --check"
  },
  "dependencies": {
    "@stats47/ai-content": "*",
    "@stats47/area": "*",
    "@stats47/area-profile": "*",
    "@stats47/category": "*",
    "@stats47/components": "*",
    "@stats47/correlation": "*",
    "@stats47/data-configs": "*",
    "@stats47/estat-api": "*",
    "@stats47/gis": "*",
    "@stats47/logger": "*",
    "@stats47/migration-flow": "*",
    "@stats47/r2-storage": "*",
    "@stats47/ranking": "*",
    "@stats47/station-passengers": "*",
    "@stats47/stats-r2": "*",
    "@stats47/types": "*",
    "@stats47/utils": "*",
    "@stats47/visualization": "*",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/unist": "^3.0.3",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "iconv-lite": "^0.7.1",
    "katex": "^0.16.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "minisearch": "^7.2.0",
    "next": "15.5.24",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@next/bundle-analyzer": "^16.2.4",
    "@next/eslint-plugin-next": "^16.0.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.58.1",
    "@stats47/database": "*",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/flexsearch": "^0.7.6",
    "@types/geojson": "^7946.0.16",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mdx": "^2.0.13",
    "@types/node": "20.19.20",
    "@types/node-fetch": "^2.6.13",
    "@types/parse-json": "^4.0.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.23",
    "better-sqlite3": "^12.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "js-yaml": "^4.3.1",
    "jsdom": "^27.0.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "webpack": "5.101.2",
    "esbuild": "^0.25.0",
    "ajv": "^8.17.1",
    "css-loader": "^7.1.2"
  }
}
