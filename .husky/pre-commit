#!/bin/sh
# Pre-commitチェックスクリプトを実行
bash apps/web/scripts/pre-commit-checks.sh || exit 1
# lyra の規則 (style-lyra.css) の部品の className への書き込み漏れ・cn-* の組み立て
# (PR CI の static-gates と同一。正典: packages/ui-theme/README.md。実測 1 秒未満)
