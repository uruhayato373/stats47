{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "配色の台帳 (指標 × 粒度。生成物)",
  "description": "型は packages/types/src/color-policy.ts の ColorPolicyRow",
  "type": "object",
  "required": [
    "schemaVersion",
    "summary",
    "policies"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "rows",
        "continuous",
        "stepped",
        "diverging"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "continuous": {
          "type": "integer",
          "minimum": 0
        },
        "stepped": {
          "type": "integer",
          "minimum": 0
        },
        "diverging": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metricKey",
          "grain",
          "colorSchemeType",
          "classification",
          "year",
          "areaCount"
        ],
        "additionalProperties": false,
        "properties": {
          "metricKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "grain": {
            "enum": [
              "prefecture",
              "municipality-merged",
              "municipality-split"
            ]
          },
          "colorSchemeType": {
            "enum": [
              "sequential",
              "diverging"
            ]
          },
          "classification": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "method"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "const": "continuous"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "method",
                  "classes"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "equal-interval",
                      "quantile"
                    ]
                  },
                  "classes": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 9
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "method",
                  "thresholds"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "const": "threshold"
                  },
                  "thresholds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          },
          "colorScheme": {
            "type": "string",
            "pattern": "^interpolate[A-Za-z]+$"
          },
          "year": {
            "type": "string",
            "pattern": "^\\d{4}"
          },
          "areaCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
