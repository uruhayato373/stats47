{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "参考文献由来の指標の展開判断",
  "description": "data/source-inventory/placement-decisions.json の形の契約。参考文献由来の指標を展開先ごとに planned (企画した) / rejected (見送り・理由必須) / blocked (停止中) と決めた記録。採用して載せたものは書かない (展開先の正本が持つ)。管理画面 /content/references が読む。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "metricKey", "status", "reason", "decidedAt", "decidedBy"],
        "properties": {
          "channel": { "enum": ["theme", "area", "japan", "blog", "note", "youtube", "instagram", "x"] },
          "metricKey": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "rejected", "blocked"] },
          "target": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "decidedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "decidedBy": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
