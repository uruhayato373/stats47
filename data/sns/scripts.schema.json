{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stats47 SNS 長尺台本 (data/sns/scripts/<post_id>.json)",
  "description": "YouTube 等の長尺投稿の台本。台帳 posts.json の行の script_path から参照する。短文・カルーセルの台本は台帳の caption を正とし、ここには置かない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["post_id", "title", "description", "sources"],
  "properties": {
    "post_id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "title"],
        "properties": {
          "start": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$" },
          "title": { "type": "string", "minLength": 1 },
          "narration": { "type": "string" }
        }
      }
    },
    "narration": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "metric_key": { "type": ["string", "null"] },
          "survey_id": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
