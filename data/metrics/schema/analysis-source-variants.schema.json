{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "variants"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metricKey",
          "scope",
          "statsDataId",
          "code",
          "unit",
          "label",
          "yearFormat",
          "definition",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "metricKey": {
            "type": "string",
            "minLength": 1
          },
          "statsDataId": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "prefecture",
              "municipality"
            ]
          },
          "yearFormat": {
            "enum": [
              "calendar",
              "fiscal"
            ]
          }
        }
      }
    }
  }
}
