{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stats47 note マガジン台帳",
  "description": "data/note/magazines.json の形の契約。記事台帳の magazine が参照するキーの正本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "magazines"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "magazines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "isPaid", "description", "verticals", "noteUrl"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "isPaid": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "verticals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["stats47-note", "koumuin-claude-code", "koumuin-estat-claude-code", "koumuin-gis", "product-sales", "membership"] }
          },
          "noteUrl": { "type": ["string", "null"], "pattern": "^https://note\\.com/stats47/m/m[a-f0-9]+$" },
          "productTarget": { "type": "string", "pattern": "^/products/[A-Za-z0-9-]+$" },
          "placeholder": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
