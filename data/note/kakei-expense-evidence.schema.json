{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "note 家計シリーズの費目→根拠指標の対応表",
  "description": "data/note/kakei-expense-evidence.json の形の契約。十大費目ごとに、突出を裏付ける根拠指標 (方向・優先度・理由) を持つ。build-kakei-note-evidence-data.mjs が読む。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "thresholds", "entries"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "thresholds": {
      "type": "object", "additionalProperties": false, "required": ["strong", "weak"],
      "properties": { "strong": { "type": "integer", "minimum": 1 }, "weak": { "type": "integer", "minimum": 1 } }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["catName", "shareMetricKey", "evidence"],
        "properties": {
          "catName": { "type": "string", "minLength": 1 },
          "shareMetricKey": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["metricKey", "direction", "priority", "rationale"],
              "properties": {
                "metricKey": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["same", "inverse"] },
                "priority": { "type": "integer", "minimum": 1 },
                "rationale": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
