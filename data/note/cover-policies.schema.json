{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "note cover category policies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "account",
    "commonPrompt",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "account": {
      "const": "stats47"
    },
    "commonPrompt": {
      "type": "string",
      "minLength": 1
    },
    "completePrompt": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/policy"
      }
    },
    "completePromptV2": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "category",
        "label",
        "readerValue",
        "direction",
        "accent",
        "prompt",
        "copyRules",
        "reviewChecklist"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NCP-[0-9]{3}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "const": "imagegen-complete"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "readerValue": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "copyRules": {
          "$ref": "#/definitions/lines"
        },
        "reviewChecklist": {
          "$ref": "#/definitions/lines"
        },
        "visualRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layout",
            "characters",
            "supplementMinPxAt320",
            "checks"
          ],
          "properties": {
            "layout": {
              "enum": [
                "prefecture-map",
                "topic-object",
                "topic-comparison",
                "work-tools",
                "color-materials"
              ]
            },
            "characters": {
              "const": "forbidden"
            },
            "supplementMinPxAt320": {
              "type": "integer",
              "minimum": 12,
              "maximum": 20
            },
            "checks": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z]+$"
              }
            }
          }
        }
      }
    }
  }
}
