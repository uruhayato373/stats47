{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stats47 note cover asset ledger",
  "description": "data/note/cover-assets.json の形の契約。記事ごとに、どの版が候補・採用・公開かの参照と公開の観測だけを持つ正本。制作内容 (production) と版の記録 (revisions: 保存先・SHA・レビュー・生成元) は記事ごとの data/note/cover-records/<articleKey>.json (cover-records.schema.json) に置き、candidateRevisionId・approvedRevisionId・published.revisionId はその版の id を指す。読み書きは .claude/scripts/note/lib/cover-assets.mjs だけが 2 つを結んで行う (このファイルだけを読んでも制作内容と版は分からない)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "account",
    "updatedAt",
    "articles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "account": {
      "const": "stats47"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/article"
      }
    }
  },
  "definitions": {
    "nullableId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articleKey",
        "noteUrl",
        "candidateRevisionId",
        "approvedRevisionId",
        "published",
        "missingVersions"
      ],
      "properties": {
        "articleKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "noteUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://note\\.com/stats47/n/n[a-f0-9]+$"
        },
        "candidateRevisionId": {
          "$ref": "#/definitions/nullableId"
        },
        "approvedRevisionId": {
          "$ref": "#/definitions/nullableId"
        },
        "missingVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "published": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "status",
            "url",
            "observedAt",
            "revisionId"
          ],
          "properties": {
            "status": {
              "enum": [
                "configured",
                "missing",
                "unknown"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://assets\\.st-note\\.com/"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "revisionId": {
              "$ref": "#/definitions/nullableId"
            }
          }
        }
      }
    }
  }
}
