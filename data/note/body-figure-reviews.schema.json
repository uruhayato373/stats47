{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "note 本文の照合で確認した誤検知",
  "description": "body-figures の照合が挙げた主張のうち、人が本文を読んで誤りではないと確かめたもの。記事 key ごとに検査の文言のまま持つので、本文が変わって別の主張が出ればまた挙がる",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviews",
    "metricOverrides"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "reason",
            "reviewedAt"
          ],
          "properties": {
            "issue": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 5
            },
            "reviewedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "metricOverrides": {
      "type": "object",
      "description": "本文に指標の手がかりが無い旧記事の指標と年。本文の県名と数字を全指標の値と照らして決めた",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rankingKey",
          "evidence"
        ],
        "properties": {
          "rankingKey": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
