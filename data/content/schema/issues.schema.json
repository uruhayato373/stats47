{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "問いの台帳。問いは分類軸ではなく、ページを結ぶ参照関係の起点 (docs/01_技術設計/03_情報設計.md)。意味の検査は .claude/scripts/issues/check-issue-graph.mjs",
  "type": "object",
  "definitions": {
    "metricRef": {
      "type": "object",
      "required": ["metric"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "grain": { "description": "問いの unit と違う粒度の値で答えるときだけ書く", "$ref": "common.schema.json#/$defs/grain" }
      }
    },
    "seriesRef": {
      "type": "object",
      "required": ["series"],
      "additionalProperties": false,
      "properties": { "series": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
    },
    "axis": {
      "type": "object",
      "required": ["label", "pattern"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "pattern": { "enum": ["compare", "compose", "change"] },
        "group": { "description": "説明側が群の区分 (年収五分位・世帯類型・有無・東西など) のとき true。区分ごとの値は関係ではなく比較・推移の図にする", "const": true },
        "data": {
          "description": "軸が使うデータへの参照。指標 (metric) か系列 (series = 家計調査の分析単位。年収階級など属性別の値)。実在は check-datasets の refs、粒度は issues:check が見る",
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "$ref": "#/definitions/metricRef" }, { "$ref": "#/definitions/seriesRef" }] }
        }
      }
    }
  },
  "required": ["version", "issues"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "question", "unit", "answerability", "sensitive", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^issue:[A-Z][0-9]{2}(-[0-9]+)?$" },
          "level": { "enum": ["major", "minor"] },
          "question": { "type": "string", "minLength": 5 },
          "unit": { "enum": ["prefecture", "municipality", "japan"] },
          "answerability": { "enum": ["relation", "caveat", "myth"] },
          "primaryTheme": { "type": ["string", "null"], "pattern": "^theme:" },
          "dataNote": {
            "description": "使う統計の説明。e-Stat の表 ID (10 桁) は書かず estatTables に、指標と系列は axes の data に書く (ID を文章に埋めると検査で辿れない)",
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "[0-9]{10}" }
          },
          "estatTables": {
            "description": "答えに使う e-Stat の表 ID (statsDataId)。指標や系列になっていない表を指すときに書く",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{10}$" }
          },
          "pitfall": { "type": "string", "minLength": 1 },
          "queries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "revenue": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["広告", "データ", "ノウハウ", "実務"] } },
          "products": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^note:.+$" } },
          "books": { "description": "問いから企画・出版した Kindle の本の ID (カタログ products.kindle-books のキー)。企画の段階 (status: idea) の本も書く。同じ指標を使うだけの本は書かない", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^K-S[1-4]-\\d{2}$" } },
          "sensitive": { "type": "boolean" },
          "status": { "enum": ["active", "dropped"] },
          "dropReason": { "type": "string", "minLength": 1 },
          "axes": {
            "description": "分析の軸。説明側 (null は記述の問い) と結果側を 比較・構成・変化 のどれかで書く。図の目的と型は issue-graph-core.mjs の resolveAxesFigure が図の型の台帳から引く",
            "type": "object",
            "required": ["explanatory", "outcome"],
            "additionalProperties": false,
            "properties": {
              "explanatory": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/axis" }] },
              "outcome": { "$ref": "#/definitions/axis" }
            }
          }
        }
      }
    }
  }
}
