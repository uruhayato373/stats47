{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "問いの台帳。問いは分類軸ではなく、ページを結ぶ参照関係の起点 (docs/01_技術設計/03_情報設計.md)。意味の検査は .claude/scripts/issues/check-issue-graph.mjs",
  "type": "object",
  "definitions": {
    "axis": {
      "type": "object",
      "required": ["label", "pattern"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "pattern": { "enum": ["compare", "compose", "change"] },
        "metrics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
      }
    }
  },
  "required": ["version", "issues"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "question", "unit", "answerability", "sensitive", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^issue:[A-Z][0-9]{2}(-[0-9]+)?$" },
          "level": { "enum": ["major", "minor"] },
          "question": { "type": "string", "minLength": 5 },
          "unit": { "enum": ["prefecture", "municipality", "japan"] },
          "answerability": { "enum": ["relation", "caveat", "myth"] },
          "primaryTheme": { "type": ["string", "null"], "pattern": "^theme:" },
          "dataNote": { "type": "string", "minLength": 1 },
          "pitfall": { "type": "string", "minLength": 1 },
          "queries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "revenue": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["広告", "データ", "ノウハウ", "実務"] } },
          "products": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^note:.+$" } },
          "sensitive": { "type": "boolean" },
          "status": { "enum": ["active", "dropped"] },
          "dropReason": { "type": "string", "minLength": 1 },
          "axes": {
            "description": "分析の軸。説明側 (null は記述の問い) と結果側を 比較・構成・変化 のどれかで書く。図の目的と型は issue-graph-core.mjs の resolveAxesFigure が図の型の台帳から引く",
            "type": "object",
            "required": ["explanatory", "outcome"],
            "additionalProperties": false,
            "properties": {
              "explanatory": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/axis" }] },
              "outcome": { "$ref": "#/definitions/axis" }
            }
          }
        }
      }
    }
  }
}
