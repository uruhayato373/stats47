{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "図の台帳。1 枚の図を型 (image-templates.json) と分析 (analyses.json) に結び、同じ図をどこへ出すかを持つ。データは写さず、指標の key と年で指す。公開の状態の正本は配信先の台帳 (ページの索引・posts.json) にあり、ここの status は展開の予定を表す。",
  "type": "object",
  "required": [
    "version",
    "figures"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "analysis",
          "template",
          "title",
          "scope",
          "metrics",
          "destinations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^figure:[A-Z][0-9]{2}(-[0-9]+)?-[a-z0-9-]+$"
          },
          "analysis": {
            "type": "string",
            "pattern": "^analysis:"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reads": {
            "description": "この図で読者が何を読むか。並べ方で当然の差を主張しない",
            "type": "string",
            "minLength": 1
          },
          "colorView": {
            "description": "地図の型で、分析の目的に合わせて選ぶ見方 (packages/types/src/color-policy.ts の COLOR_VIEWS)。書かなければ配色の台帳の判定に従う。",
            "enum": [
              "continuous",
              "distribution"
            ]
          },
          "scope": {
            "enum": [
              "prefecture",
              "municipality"
            ]
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "year"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "year": {
                  "type": "integer",
                  "minimum": 1900
                }
              }
            }
          },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "channel",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "enum": [
                    "site",
                    "x",
                    "note"
                  ]
                },
                "page": {
                  "type": "string",
                  "minLength": 1
                },
                "postId": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "enum": [
                    "planned",
                    "draft",
                    "published"
                  ]
                },
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "description": "まだページの索引に無い記事の下書き。公開したら page に置き換える"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "page"
                  ]
                },
                {
                  "required": [
                    "postId"
                  ]
                },
                {
                  "required": [
                    "slug"
                  ]
                }
              ]
            }
          },
          "chart": {
            "type": "object",
            "description": "図の中身の定義。値は持たず、分析の結果の JSON のどの項目を描くかを指す",
            "required": [
              "name",
              "alt",
              "meta",
              "source",
              "rows",
              "unit",
              "transform",
              "displaySources"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "記事の図の名前。型ごとに接尾辞を決める (grouped-bar と stacked-bar は -bars、line は -lines、scatter は -scatter、boxplot は -boxplot。analysis-draft-core.mjs の NAME_SUFFIX)"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "meta": {
                "type": "string",
                "minLength": 1,
                "description": "{towns} のように結果の値を差し込める"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "rows": {
                "type": "string",
                "minLength": 1,
                "description": "結果の JSON の行の配列のキー。boxplot の行は min・q1・median・q3・max を数で持つ"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "行の名前の項目。棒・積み上げの棒・スロープの線・箱ひげの行の名前になる"
              },
              "count": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "transform": {
                "type": "string",
                "minLength": 1
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "field"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "description": "行から値を読む項目。grouped-bar は系列、stacked-bar は 100% 積み上げの区分 (行の合計を 100% として描く)、line に書くと 2 時点の変化 (スロープ) で始点と終点の 2 つ"
              },
              "displaySources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "surveyId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "decimals": {
                "type": "integer",
                "minimum": 0
              },
              "note": {
                "type": "string"
              },
              "xLabel": {
                "type": "string"
              },
              "yLabel": {
                "type": "string"
              },
              "correlationField": {
                "type": "string",
                "description": "散布図の相関係数を持つ結果のキー"
              }
            }
          }
        }
      }
    }
  }
}
