{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "key",
          "title",
          "href",
          "published"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "pattern": "^(/|https://)"
          },
          "published": {
            "type": "boolean"
          },
          "rankingKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "tagIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^tag:"
            }
          }
        }
      }
    }
  }
}
