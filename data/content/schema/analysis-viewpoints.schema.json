{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "分析で確かめる視点の層。analyses.json の viewpoints が全ての層に結果か対象外の理由を持つ。",
  "type": "object",
  "required": ["version", "layers"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "ask"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "label": { "type": "string", "minLength": 1 },
          "ask": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
