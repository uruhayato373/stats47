{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "shards",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/link"
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "explains",
            "contains",
            "uses",
            "geo",
            "sharedMetric",
            "tag",
            "themeContext"
          ]
        }
      }
    }
  }
}
