{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "問いに答える分析の台帳。問い (issues.json) と図 (figures.json) の間に立つ。計算の入力と再現の手順を持ち、値は持たない。finding は採用した結論の文で、数字はスクリプトの result.json から再現できるものだけを書く。",
  "type": "object",
  "required": ["version", "analyses"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issue", "status", "question", "spec", "script", "finding", "caveats", "observedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^analysis:[A-Z][0-9]{2}(-[0-9]+)?-[a-z0-9-]+$" },
          "issue": { "type": "string", "pattern": "^issue:" },
          "status": { "enum": ["draft", "adopted", "dropped"] },
          "question": { "type": "string", "minLength": 5 },
          "spec": { "type": "string", "pattern": "^\\.claude/scripts/analysis/" },
          "script": { "type": "string", "pattern": "^\\.claude/scripts/analysis/" },
          "finding": { "type": "string", "minLength": 1 },
          "caveats": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
