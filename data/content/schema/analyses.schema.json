{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "問いに答える分析の台帳。問い (issues.json) と図 (figures.json) の間に立つ。計算の入力と再現の手順を持ち、値は持たない。finding は採用した結論の文で、数字はスクリプトの result.json から再現できるものだけを書く。",
  "type": "object",
  "required": [
    "version",
    "analyses"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "issue",
          "status",
          "question",
          "spec",
          "script",
          "finding",
          "caveats",
          "observedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^analysis:[A-Z][0-9]{2}(-[0-9]+)?-[a-z0-9-]+$"
          },
          "issue": {
            "type": "string",
            "pattern": "^issue:"
          },
          "status": {
            "enum": [
              "draft",
              "adopted",
              "dropped"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "stage": {
            "description": "工程。判定は .claude/scripts/analysis/analysis-cycle-core.mjs",
            "enum": ["framed", "viewpoints", "figures", "draft", "reviewed", "approved", "published", "evaluated"]
          },
          "questionTerms": {
            "description": "台帳の問いの語。結論と記事がこの語で答える",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "viewpoints": {
            "description": "視点の層ごとの結果。evidence は analysis-summary.json の中のキー",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["layer", "status"],
              "additionalProperties": false,
              "properties": {
                "layer": { "type": "string" },
                "status": { "enum": ["done", "na"] },
                "result": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "claims": {
            "description": "結論の主張。value と interval は analysis-summary.json の中のキー。above / below / straddles は幅と照らす基準で、言い過ぎを機械で止める",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "value"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 },
                "interval": { "type": "string", "minLength": 1 },
                "above": { "type": "number" },
                "below": { "type": "number" },
                "straddles": { "type": "number" }
              }
            }
          },
          "refutation": {
            "description": "反証の記録。summarySha256 は反証した時点の analysis-summary.json のハッシュ。分析の出力が変わると無効になる",
            "type": "object",
            "required": ["reviewer", "at", "summarySha256", "checks"],
            "additionalProperties": false,
            "properties": {
              "reviewer": { "type": "string", "minLength": 1 },
              "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "summarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["claim", "test", "numbers", "verdict"],
                  "additionalProperties": false,
                  "properties": {
                    "claim": { "type": "string", "minLength": 1 },
                    "test": { "type": "string", "minLength": 1 },
                    "numbers": { "type": "string", "minLength": 1 },
                    "verdict": { "enum": ["holds", "weak", "broken"] }
                  }
                }
              }
            }
          },
          "spec": {
            "type": "string",
            "pattern": "^\\.claude/scripts/analysis/"
          },
          "script": {
            "type": "string",
            "pattern": "^\\.claude/scripts/analysis/"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "derivedMetrics": {
            "type": "array",
            "description": "入力の掛け算や割り算で求めた指標。同じ定義のランキングがある key を書く",
            "items": { "type": "object", "required": ["key", "label"], "additionalProperties": false, "properties": { "key": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } } }
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "article": {
            "type": "object",
            "description": "記事の下書きの入力。npm run analysis:draft が読む",
            "required": [
              "slug",
              "titleHint",
              "chars",
              "links"
            ],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "titleHint": {
                "type": "string",
                "minLength": 1
              },
              "chars": {
                "type": "string",
                "pattern": "^\\d+-\\d+$"
              },
              "links": {
                "$ref": "#/definitions/links"
              },
              "sourceLinks": {
                "$ref": "#/definitions/links"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "href",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "pattern": "^/"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
