{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "問いに答える分析の台帳。問い (issues.json) と図 (figures.json) の間に立つ。計算の入力と再現の手順を持ち、値は持たない。finding は採用した結論の文で、数字はスクリプトの result.json から再現できるものだけを書く。",
  "type": "object",
  "required": [
    "version",
    "analyses"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "issue",
          "status",
          "question",
          "spec",
          "script",
          "finding",
          "caveats",
          "observedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^analysis:[A-Z][0-9]{2}(-[0-9]+)?-[a-z0-9-]+$"
          },
          "issue": {
            "type": "string",
            "pattern": "^issue:"
          },
          "status": {
            "enum": [
              "draft",
              "adopted",
              "dropped"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "spec": {
            "type": "string",
            "pattern": "^\\.claude/scripts/analysis/"
          },
          "script": {
            "type": "string",
            "pattern": "^\\.claude/scripts/analysis/"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "derivedMetrics": {
            "type": "array",
            "description": "入力の掛け算や割り算で求めた指標。同じ定義のランキングがある key を書く",
            "items": { "type": "object", "required": ["key", "label"], "additionalProperties": false, "properties": { "key": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } } }
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "article": {
            "type": "object",
            "description": "記事の下書きの入力。npm run analysis:draft が読む",
            "required": [
              "slug",
              "titleHint",
              "chars",
              "links"
            ],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "titleHint": {
                "type": "string",
                "minLength": 1
              },
              "chars": {
                "type": "string",
                "pattern": "^\\d+-\\d+$"
              },
              "links": {
                "$ref": "#/definitions/links"
              },
              "sourceLinks": {
                "$ref": "#/definitions/links"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "href",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "pattern": "^/"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
