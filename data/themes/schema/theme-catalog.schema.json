                            "male",
                            "female",
                            "danger",
                            "count",
                            "improve",
                            "neutral",
                            "special",
                            "series-1",
                            "series-2",
                            "series-3",
                            "series-4",
                            "series-5",
                            "series-6",
                            "series-7",
                            "series-8",
                            "series-9",
