{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stats47 theme catalog",
  "description": "テーマページ (/themes/<key>) の指標・チャート・選定根拠の定義。型の正典は packages/data-configs/src/theme-catalog/types.ts の ThemeCatalog。意味の検査 (指標の実在・単位・章の参照) は validate-theme-catalog.ts が行い、ここでは形だけを固定する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "title",
    "description",
    "category",
    "usage",
    "metrics",
    "charts"
  ],
  "properties": {
    "key": {
      "$ref": "#/definitions/kebabKey"
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "$ref": "#/definitions/text"
    },
    "category": {
      "enum": [
        "demographics",
        "economy",
        "finance",
        "welfare",
        "education",
        "lifestyle",
        "safety",
        "industry",
        "tourism"
      ]
    },
    "usage": {
      "enum": [
        "theme",
        "compare",
        "both"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/metric"
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/chart"
      }
    },
    "metricGroups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/metricGroup"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    },
    "evidenceTopics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidenceTopic"
      }
    },
    "keywords": {
      "$ref": "#/definitions/stringList"
    },
    "relatedArticleTagKeys": {
      "$ref": "#/definitions/stringList"
    },
    "rejectedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rankingKey",
          "reason"
        ],
        "properties": {
          "rankingKey": {
            "$ref": "#/definitions/rankingKey"
          },
          "reason": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "harmRelevance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "reason"
        ],
        "properties": {
          "axis": {
            "enum": [
              "health",
              "ambition",
              "relation",
              "money"
            ]
          },
          "reason": {
            "$ref": "#/definitions/text"
          }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kebabKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rankingKey": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposedBy",
        "surveyedAt",
        "rationale"
      ],
      "properties": {
        "proposedBy": {
          "$ref": "#/definitions/text"
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "surveyedAt": {
          "$ref": "#/definitions/text"
        },
        "rationale": {
          "$ref": "#/definitions/text"
        },
        "adoptionCriteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "representativeness",
              "comparability",
              "complementarity",
              "dataQuality",
              "readerValue"
            ]
          }
        },
        "readerQuestion": {
          "$ref": "#/definitions/text"
        },
        "targetReaderOrDecision": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rankingKey",
        "shortLabel",
        "role"
      ],
      "properties": {
        "rankingKey": {
          "$ref": "#/definitions/rankingKey"
        },
        "shortLabel": {
          "$ref": "#/definitions/text"
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "context"
          ]
        },
        "selection": {
          "$ref": "#/definitions/selection"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentKey",
        "componentType",
        "title",
        "componentProps",
        "sortOrder"
