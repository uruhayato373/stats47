{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stats47 theme catalog",
  "description": "テーマページ (/themes/<key>) の指標・チャート・選定根拠の定義。型の正典は packages/data-configs/src/theme-catalog/types.ts の ThemeCatalog。意味の検査 (指標の実在・単位・章の参照) は validate-theme-catalog.ts が行い、ここでは形だけを固定する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "title", "description", "category", "usage", "metrics", "charts"],
  "properties": {
    "key": { "$ref": "#/definitions/kebabKey" },
    "title": { "$ref": "#/definitions/text" },
    "description": { "$ref": "#/definitions/text" },
    "category": {
      "enum": ["demographics", "economy", "finance", "welfare", "education", "lifestyle", "safety", "industry", "tourism"]
    },
    "usage": { "enum": ["theme", "compare", "both"] },
    "metrics": { "type": "array", "items": { "$ref": "#/definitions/metric" } },
    "charts": { "type": "array", "items": { "$ref": "#/definitions/chart" } },
    "metricGroups": { "type": "array", "items": { "$ref": "#/definitions/metricGroup" } },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/section" } },
    "evidenceTopics": { "type": "array", "items": { "$ref": "#/definitions/evidenceTopic" } },
    "keywords": { "$ref": "#/definitions/stringList" },
    "relatedArticleTagKeys": { "$ref": "#/definitions/stringList" },
    "rejectedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rankingKey", "reason"],
        "properties": {
          "rankingKey": { "$ref": "#/definitions/rankingKey" },
          "reason": { "$ref": "#/definitions/text" }
        }
      }
    },
    "harmRelevance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "reason"],
        "properties": {
          "axis": { "enum": ["health", "ambition", "relation", "money"] },
          "reason": { "$ref": "#/definitions/text" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "kebabKey": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "rankingKey": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nullableString": { "type": ["string", "null"] },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposedBy", "surveyedAt", "rationale"],
      "properties": {
        "proposedBy": { "$ref": "#/definitions/text" },
        "sourceUrl": { "type": "string", "minLength": 1 },
        "surveyedAt": { "$ref": "#/definitions/text" },
        "rationale": { "$ref": "#/definitions/text" },
        "adoptionCriteria": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["representativeness", "comparability", "complementarity", "dataQuality", "readerValue"] }
        },
        "readerQuestion": { "$ref": "#/definitions/text" },
        "targetReaderOrDecision": { "$ref": "#/definitions/text" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rankingKey", "shortLabel", "role"],
      "properties": {
        "rankingKey": { "$ref": "#/definitions/rankingKey" },
        "shortLabel": { "$ref": "#/definitions/text" },
        "role": { "enum": ["primary", "secondary", "context"] },
        "selection": { "$ref": "#/definitions/selection" }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentKey", "componentType", "title", "componentProps", "sortOrder"],
      "properties": {
        "componentKey": { "$ref": "#/definitions/text" },
        "componentType": {
          "enum": ["line-chart", "mixed-chart", "composition-chart", "donut-chart", "cpi-profile", "cpi-heatmap", "kpi-card", "markdown-section", "pyramid-chart"]
        },
        "title": { "$ref": "#/definitions/text" },
        "annotation": { "type": "string" },
        "componentProps": { "type": "object" },
        "relatedRankingKeys": { "type": "array", "items": { "$ref": "#/definitions/rankingKey" } },
        "sourceName": { "$ref": "#/definitions/nullableString" },
        "sourceLink": { "$ref": "#/definitions/nullableString" },
        "gridColumnSpan": { "type": "integer", "minimum": 1, "maximum": 12 },
        "gridColumnSpanTablet": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "gridColumnSpanSm": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "dataSource": { "$ref": "#/definitions/nullableString" },
        "section": { "$ref": "#/definitions/nullableString" },
        "sortOrder": { "type": "number" },
        "comparisonBasis": { "type": "string" },
        "visualizationRationale": { "type": "string" }
      }
    },
    "metricGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "rankingKeys", "defaultCheckedKeys"],
      "properties": {
        "comparisonYear": { "type": "string", "pattern": "^\\d{4}$" },
        "comparisonMap": { "type": "boolean" },
        "key": { "$ref": "#/definitions/kebabKey" },
        "title": { "$ref": "#/definitions/text" },
        "rankingKeys": { "type": "array", "items": { "$ref": "#/definitions/rankingKey" } },
        "defaultCheckedKeys": { "type": "array", "items": { "$ref": "#/definitions/rankingKey" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "metricGroupKeys"],
      "properties": {
        "key": { "$ref": "#/definitions/kebabKey" },
        "title": { "$ref": "#/definitions/text" },
        "description": { "type": "string" },
        "metricGroupKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "chartKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "embeddedSectionKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidenceTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "lensKey", "title", "question", "summary", "sourceKeys"],
      "properties": {
        "key": { "$ref": "#/definitions/kebabKey" },
        "lensKey": { "$ref": "#/definitions/text" },
        "title": { "$ref": "#/definitions/text" },
        "question": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" },
        "sourceKeys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "relatedRankingKeys": { "type": "array", "items": { "$ref": "#/definitions/rankingKey" } },
        "relatedChartKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "relatedThemeKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "relatedArticleTagKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
