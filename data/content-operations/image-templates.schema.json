{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/template"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/template"
      }
    }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "label",
        "policy",
        "profiles",
        "renderer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "renderer": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "chart = 主な統計図、chart-minor = 使用例の少ない統計図、asset = 統計図以外の素材 (カード・カバー等)。省略時は asset",
          "enum": ["chart", "chart-minor", "asset"]
        },
        "purposes": {
          "description": "この型で描ける用途 (taxonomy.mjs の IMAGE_PURPOSES)。型の木構造ではなく属性として持つ",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["ranking", "comparison", "trend", "composition", "relationship", "distribution", "explanation", "navigation", "reference"]
          }
        },
        "metricColor": {
          "description": "指標台帳の配色 (data/metrics/<key>.ts の visualization) の使い方。scale = 値の濃淡で塗る (tile-scale.ts の resolveTileScale)、single = 指標の色 1 色 (resolveMetricColor)、none = 系列・区分の色で指標の配色を使わない",
          "enum": ["scale", "single", "none"]
        },
        "variants": {
          "description": "同じ型の中の描き分け (地図の重ね方・出し方)。別の型にはしない",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z-]+$" },
              "label": { "type": "string", "minLength": 1 },
              "status": { "enum": ["ready", "planned"] },
              "buzzMapTypes": {
                "description": "バズ地図の型 (buzz-map-standards.md §1) のうち、この描き分けに当たるもの",
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^([A-F]|flow)$" }
              }
            }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "note",
            "x",
            "instagram"
          ],
          "properties": {
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "x": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "instagram": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "web": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          }
        }
      }
    }
  }
}
