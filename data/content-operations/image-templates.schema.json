{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,"required":["schemaVersion","templates"],
  "properties":{
    "schemaVersion":{"const":1},
    "templates":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/template"}},
    "history":{"type":"array","items":{"$ref":"#/definitions/template"}}
  },
  "definitions":{
    "template":{"type":"object","additionalProperties":false,"required":["id","version","label","policy","profiles","renderer"],"properties":{
      "id":{"type":"string","pattern":"^[a-z-]+$"},"version":{"type":"integer","minimum":1},"label":{"type":"string","minLength":1},
      "policy":{"type":"string","minLength":1,"maxLength":10000},"renderer":{"type":["string","null"]},
      "profiles":{"type":"object","additionalProperties":false,"required":["note","x","instagram"],"properties":{"note":{"type":"string","minLength":1,"maxLength":5000},"x":{"type":"string","minLength":1,"maxLength":5000},"instagram":{"type":"string","minLength":1,"maxLength":5000}}}
    }}
  }
}
