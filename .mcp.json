{
  "mcpServers": {
    "cloudflare-observability": {
      "type": "http",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "cloudflare-graphql": {
      "type": "http",
      "url": "https://graphql.mcp.cloudflare.com/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "seo-observability": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/scripts/search-growth/mcp/server.mjs"]
    },
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server"]
    }
  }
}
