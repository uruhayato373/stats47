{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "cloudflare-observability": {
      "type": "sse",
      "url": "https://observability.mcp.cloudflare.com/sse"
    },
    "cloudflare-graphql": {
      "type": "sse",
      "url": "https://graphql.mcp.cloudflare.com/sse"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "seo-observability": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/scripts/search-growth/mcp/server.mjs"]
    }
  }
}
