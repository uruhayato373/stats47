{
  "name": "@stats47/ai-content",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "ai:list": "tsx src/scripts/list-pending.ts",
    "ai:list:force": "tsx src/scripts/list-pending.ts --force",
    "ai:input": "tsx src/scripts/build-input.ts",
    "ai:verify": "tsx src/scripts/verify-inputs.ts",
    "ai:preflight": "tsx src/scripts/preflight-gemini.ts",
    "ai:gen": "tsx src/scripts/generate-parallel.ts",
    "ai:gen:dry": "tsx src/scripts/generate-parallel.ts --dry-run"
  },
  "dependencies": {
    "@stats47/area": "*",
    "@stats47/logger": "*",
    "@stats47/r2-storage": "*",
    "@stats47/ranking": "*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
