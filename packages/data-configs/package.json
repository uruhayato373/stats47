{
  "name": "@stats47/data-configs",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./src/registry.ts",
      "require": "./src/registry.ts"
    },
    "./categories": {
      "types": "./src/categories.ts",
      "import": "./src/categories.ts",
      "require": "./src/categories.ts"
    },
    "./home-portal": {
      "types": "./src/home-portal.ts",
      "import": "./src/home-portal.ts",
      "require": "./src/home-portal.ts"
    },
    "./theme-catalog": {
      "types": "./src/theme-catalog/index.ts",
      "import": "./src/theme-catalog/index.ts",
      "require": "./src/theme-catalog/index.ts"
    },
    "./prominence": {
      "types": "./src/prominence/index.ts",
      "import": "./src/prominence/index.ts",
      "require": "./src/prominence/index.ts"
    },
    "./ranking-prominence": {
      "types": "./src/prominence/ranking-prominence.generated.ts",
      "import": "./src/prominence/ranking-prominence.generated.ts",
      "require": "./src/prominence/ranking-prominence.generated.ts"
    }
  },
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "validate:years": "tsx scripts/validate-metric-years.ts",
    "validate:config": "tsx scripts/validate-metric-config.ts",
    "generate:catalog": "tsx scripts/generate-theme-catalog.ts",
    "validate:catalog": "tsx scripts/validate-theme-catalog.ts",
    "generate:area-databook": "tsx scripts/generate-area-databook.ts",
    "generate:editorial-index": "tsx scripts/generate-editorial-index.ts",
    "validate:area-databook": "tsx scripts/validate-area-databook.ts",
    "validate:prefecture-statistics": "tsx scripts/validate-prefecture-statistics-catalog.ts",
    "check:prefecture-statistics-links": "tsx scripts/check-prefecture-statistics-links.ts",
    "validate:open-data-catalog": "tsx scripts/validate-open-data-catalog.ts",
    "check:open-data-links": "tsx scripts/check-open-data-links.ts",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "validate:polarity": "tsx scripts/validate-polarity.ts"
  },
  "dependencies": {
    "@stats47/types": "*"
  },
  "devDependencies": {
    "better-sqlite3": "^12.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
