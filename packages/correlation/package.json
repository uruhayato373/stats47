{
  "name": "@stats47/correlation",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    }
  },
  "scripts": {
    "batch": "tsx -r ../ranking/src/scripts/setup-cli.js src/scripts/run-batch.ts",
    "export-snapshot": "tsx -r ../ranking/src/scripts/setup-cli.js src/scripts/export-snapshot.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stats47/area": "*",
    "@stats47/data-configs": "*",
    "@stats47/logger": "*",
    "@stats47/r2-storage": "*",
    "@stats47/stats-r2": "*",
    "@stats47/types": "*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
