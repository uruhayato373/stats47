{
  "name": "@stats47/gis",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./geoshape": {
      "types": "./src/geoshape/index.ts",
      "import": "./src/geoshape/index.ts",
      "require": "./src/geoshape/index.ts"
    },
    "./geoshape/types": {
      "types": "./src/geoshape/types/index.ts",
      "import": "./src/geoshape/types/index.ts",
      "require": "./src/geoshape/types/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    },
    "./mlit": {
      "types": "./src/mlit/index.ts",
      "import": "./src/mlit/index.ts",
      "require": "./src/mlit/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "import": "./src/export/index.ts",
      "require": "./src/export/index.ts"
    },
    "./mlit-ksj": {
      "types": "./src/mlit-ksj/index.ts",
      "import": "./src/mlit-ksj/index.ts",
      "require": "./src/mlit-ksj/index.ts"
    }
  },
  "scripts": {
    "check:thumbnail-topology": "node scripts/generate-prefecture-thumbnail-topology.mjs --check",
    "generate:thumbnail-topology": "node scripts/generate-prefecture-thumbnail-topology.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "build:geo-analysis": "cd ../.. && tsx packages/gis/src/mlit-ksj/scripts/build-geo-cross-snapshots.ts && tsx packages/gis/src/mlit-ksj/scripts/audit-geo-analysis-artifacts.ts",
    "build:geo-station-access": "cd ../.. && tsx packages/gis/src/mlit-ksj/scripts/build-geo-cross-snapshots.ts --station-access-only && tsx packages/gis/src/mlit-ksj/scripts/audit-geo-analysis-artifacts.ts",
    "audit:geo-analysis": "cd ../.. && tsx packages/gis/src/mlit-ksj/scripts/audit-geo-analysis-artifacts.ts",
    "build:data-catalog": "tsx src/mlit-ksj/scripts/build-data-catalog.ts build",
    "check:data-catalog": "tsx src/mlit-ksj/scripts/build-data-catalog.ts check",
    "audit:public-ksj-manifests": "tsx src/mlit-ksj/scripts/audit-public-ksj-manifests.ts",
    "audit:public-ksj-r2": "tsx src/mlit-ksj/scripts/audit-public-ksj-r2.ts",
    "acquire:public-ksj": "tsx src/mlit-ksj/scripts/acquire-public-ksj.ts",
    "acquire:mhlw-medical": "tsx src/mlit-ksj/scripts/acquire-mhlw-medical.ts"
  },
  "dependencies": {
    "@stats47/area": "*",
    "@stats47/data-configs": "*",
    "@stats47/r2-storage": "*",
    "@stats47/stats-r2": "*",
    "@stats47/types": "*",
    "csv-parse": "^7.0.2",
    "d3": "^7",
    "iconv-lite": "^0.6",
    "jsdom": "^25",
    "proj4": "^2.21.0",
    "shapefile": "^0.6.6",
    "stream-json": "^3.6.0",
    "topojson-client": "^3",
    "topojson-server": "^3",
    "topojson-simplify": "^3",
    "unzipper": "^0.12"
  },
  "devDependencies": {
    "@types/d3": "^7",
    "@types/jsdom": "^21",
    "@types/topojson-client": "^3",
    "@types/topojson-server": "^3",
    "@types/topojson-simplify": "^3",
    "dotenv": "^17.2.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
