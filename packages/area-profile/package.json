{
  "name": "@stats47/area-profile",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    }
  },
  "scripts": {
    "export:snapshot": "NODE_OPTIONS='--conditions react-server' R2_PUBLIC_FETCH_URL=https://storage.stats47.jp tsx src/scripts/export-snapshot.ts",
    "export:city": "NODE_OPTIONS='--conditions react-server' R2_PUBLIC_FETCH_URL=https://storage.stats47.jp tsx src/scripts/export-city-snapshot.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stats47/data-configs": "*",
    "@stats47/logger": "*",
    "@stats47/r2-storage": "*",
    "@stats47/ranking": "*",
    "@stats47/stats-r2": "*",
    "@stats47/types": "*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
