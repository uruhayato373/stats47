{
  "name": "@stats47/area",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./short-name": {
      "types": "./src/utils/prefecture-short-name.ts",
      "import": "./src/utils/prefecture-short-name.ts",
      "require": "./src/utils/prefecture-short-name.ts"
    },
    "./area-code": {
      "types": "./src/utils/area-code.ts",
      "import": "./src/utils/area-code.ts",
      "require": "./src/utils/area-code.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stats47/types": "*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
