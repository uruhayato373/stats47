{
  "name": "@stats47/ops",
  "version": "1.0.0",
  "private": true,
  "description": "運用の部品 (画像の制作・note・計測・課題・コンテンツの型・計画とレビュー・CI の範囲・ページ品質・参考文献)。アプリとエージェントのスクリプトが共用する。アプリは @stats47/ops/<領域>/<ファイル> で読み、.claude/scripts は相対パスで読む (依存を入れない CI の job でも動かすため)。",
  "exports": {
    "./ads/ad-layout-ledger": "./src/ads/ad-layout-ledger.ts",
    "./note/catalog": "./src/note/catalog/index.ts",
    "./note/catalog/types": "./src/note/catalog/types.ts",
    "./note/pop-cover-render": "./src/note/pop-cover-render.ts",
    "./page-quality/lib/git-diff": "./src/page-quality/lib/git-diff.ts",
    "./page-quality/templates": "./src/page-quality/templates.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.checkjs.json",
    "test": "node --import tsx --experimental-test-module-mocks --test \"src/**/__tests__/*.test.mjs\" \"src/**/__tests__/*.test.cjs\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@axe-core/playwright": "^4.12.1",
    "@stats47/area": "*",
    "@stats47/data-configs": "*",
    "@stats47/r2-storage": "*",
    "ajv": "^6.15.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.4.0",
    "jszip": "^3.10.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "proj4": "^2.21.0",
    "react": "^19.2.4",
    "satori": "^0.33.5",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "undici": "^7.30.1",
    "unzipper": "^0.12"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  }
}
