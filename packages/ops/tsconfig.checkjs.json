{
  // JavaScript の部品を型検査する。.claude/scripts/tsconfig.checkjs.json と同じ設定で、
  // 2026-11-19 にそこの検査の範囲 (lib・measurement・metrics/lib) から移した部品を、範囲を縮めずに引き継ぐ。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": [
    "src/ci/**/*.mjs",
    "src/datasets/**/*.mjs",
    "src/management/**/*.mjs",
    "src/management/**/*.cjs",
    "src/media/gallery-collectors.mjs",
    "src/media/svg-classify.mjs",
    "src/measurement/**/*.mjs",
    "src/metrics/**/*.mjs",
    "src/blog/lint/**/*.mjs",
    "src/cloudflare/googlebot.mjs",
    "src/cloudflare/threshold-check.mjs",
    "src/google/**/*.cjs",
    "src/gates/**/*.cjs",
    "src/gates/**/*.mjs",
    "src/estat/audit-time-coverage.cjs",
    "src/estat/gen-ssds-configs.mjs",
    "src/estat/catalog-api.mjs",
    "src/estat/catalog-endpoints.cjs",
    "src/estat/catalog-s3.mjs",
    "src/estat/build-monthly-ledger.mjs",
    "src/estat/catalog-index.mjs",
    "src/estat/catalog-pulled.mjs",
    "src/estat/kakei-classification.mjs",
    "src/estat/kakei-ledger.mjs",
    "src/estat/ssds-year-format.mjs",
    "src/ranking/**/*.mjs",
    "src/surveys/**/*.mjs",
    "src/sns/ig-ledger-core.cjs",
    "src/sns/sns-posted-core.cjs",
    "src/sns/threads-core.cjs",
    "src/sns/x-catalog.cjs",
    "src/sns/x-weighted-length.cjs"
  ],
  "exclude": ["node_modules", "**/__tests__/**"]
}
