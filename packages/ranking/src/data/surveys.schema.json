{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stats47.jp/schema/surveys.schema.json",
  "title": "調査マスタ (surveys.json)",
  "description": "/survey/<id> の正本。id は URL に使うので変更しない。参照整合 (parentSourceId の実在など) は __tests__/surveys-master.test.ts が検査する。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "sourceKind", "externalId", "parentSourceId", "name", "organization", "url",
      "description", "attributionText", "license", "licenseUrl", "baseUrl", "linkTemplate",
      "displayOrder", "isActive", "createdAt", "updatedAt"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "sourceKind": { "type": "string", "enum": ["survey"] },
      "externalId": { "type": ["string", "null"], "minLength": 1 },
      "parentSourceId": {
        "type": ["string", "null"],
        "minLength": 1,
        "description": "上位の出典。\"estat\" は e-Stat ポータル、それ以外は surveys.json の id (例: kakei-chousa の親は household-survey)"
      },
      "name": { "type": "string", "minLength": 1 },
      "organization": { "type": "string", "minLength": 1 },
      "url": { "type": ["string", "null"], "pattern": "^https?://" },
      "description": { "type": ["string", "null"], "minLength": 1 },
      "attributionText": { "type": ["string", "null"], "minLength": 1 },
      "license": { "type": ["string", "null"], "minLength": 1 },
      "licenseUrl": { "type": ["string", "null"], "pattern": "^https?://" },
      "baseUrl": { "type": ["string", "null"], "pattern": "^https?://" },
      "linkTemplate": { "type": ["string", "null"], "minLength": 1 },
      "displayOrder": { "type": "integer", "minimum": 0 },
      "isActive": { "type": "boolean" },
      "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
      "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" }
    }
  }
}
