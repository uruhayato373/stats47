{
  "name": "@stats47/ranking",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "require": "./src/types/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    },
    "./survey": {
      "types": "./src/survey/index.ts",
      "import": "./src/survey/index.ts",
      "require": "./src/survey/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts",
      "require": "./src/config/index.ts"
    }
  },
  "scripts": {
    "generate:municipality-ranking": "tsx src/scripts/generate-municipality-ranking.ts",
    "verify:municipality-ranking": "tsx src/scripts/verify-municipality-ranking.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stats47/estat-api": "*",
    "@stats47/area": "*",
    "@stats47/category": "*",
    "@stats47/data-configs": "*",
    "@stats47/logger": "*",
    "@stats47/r2-storage": "*",
    "@stats47/stats-r2": "*",
    "@stats47/types": "*",
    "@stats47/utils": "*",
    "@stats47/visualization": "*",
    "zod": "^4.6.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "ajv": "^6.15.0",
    "dotenv": "^17.3.1",
    "typescript": "^5.0.0",
    "undici": "^7.30.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
