{
  "name": "@stats47/r2-storage",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "require": "./src/testing/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts"
    },
    "./image-pipeline": {
      "types": "./src/image-pipeline.ts",
      "import": "./src/image-pipeline.ts",
      "require": "./src/image-pipeline.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "purge-cache": "tsx src/scripts/purge-cache.ts",
    "purge-worker-cache": "tsx src/scripts/purge-worker-cache.ts",
    "audit:incremental-cache": "tsx src/scripts/audit-incremental-cache.ts",
    "db:pull": "tsx src/scripts/db-r2-sync.ts pull",
    "db:push": "tsx src/scripts/db-r2-sync.ts push"
  },
  "dependencies": {
    "@stats47/logger": "*",
    "@stats47/types": "*",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@opennextjs/cloudflare": "^1.20.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "dotenv": "^17.2.3",
    "typescript": "^5.0.0",
    "wrangler": "4.126.0"
  }
}
