.reg/
apps/web/.reg/

# スナップショット差分（コミット不要）
apps/web/tests/visual/__screenshots__/**/*-diff.png
apps/web/tests/visual/__screenshots__/**/*-actual.png
**/__golden__/*-actual.png
**/__golden__/*-diff.png

# ベースライン画像はコミットする
!apps/web/tests/visual/__screenshots__/**/*.png

# Note記事の画像（原稿段階はgit管理。公開後にR2へ移動しgitから削除）
# docs/31_note記事原稿/*/images/

# Remotion render output
apps/remotion/out/
apps/remotion/build/

# Local development data
.local/

