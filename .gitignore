packages/database/.data/



# ルートの一時ファイル
tmp_*
tmp-*
tsc_output*.txt
type_errors_summary.md
inspect-knip.js

.git-old/
.cursor/
.cursorrules
.cursorignore
.memory-env/

# Claude Code セッション管理（ローカル専用）
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# e-Stat city meta cache (巨大ローカルキャッシュ、コミット不要)
.claude/state/estat-city-meta-cache/

# セッションロック (session-guard.js のランタイム状態、マシン固有・コミット不要)
.claude/state/session-locks/

# 週次リマインドの「今日は通知済み」マーカー (check-weekly-cadence-on-stop.js が書く)
# 中身は日付 1 行だけで、マシンごとに別々に進む。commit するとマシン間で毎日衝突し、
# 履歴も意味を持たない。session-locks と同じランタイム状態として扱う。
.claude/state/cadence/

# SNS 指標発見索引 (git TS 由来の再生成キャッシュ = SSOT ではない。build-discovery-index.ts で再生成)
.claude/state/sns/metric-discovery-index.json

# git worktree (Agent isolation 用、リポジトリにコミットしない)
.claude/worktrees/

# note 記事 (docs/31_note記事原稿/) の PNG は SVG から再生成できる派生物
# (.claude/scripts/note/regenerate-svg-png.sh で随時再生成)。容量を詰めたい公開済み記事は
# PNG を削除し SVG のみ残してよい。SVG ソースを持たない旧記事 (例: a-maximum-temperature) は
# PNG が唯一のソースなので追跡対象 (docs/31 配下の images は現状すべて追跡)。


# 再生成可能な D1 投入 SQL (seed-to-d1-sql.ts で生成)
packages/database/seed/d1-seed.sql

# マシンローカルの Claude Code 設定 (permissions 許可履歴・ローカルパス入り。git 共有しない)
# 2026-07-03 セットアップ監査: API キー混入で追跡解除 (settings.json が共有側の正)
.claude/settings.local.json

# 禁止path。source-vault:checkが存在を拒否し、ignoreは誤commitの最後の防波堤とする。
docs/books/
# 禁止path。source-vault:checkが存在を拒否し、ignoreは誤commitの最後の防波堤とする。
/books/
# 同上。参考PDFをagent設定配下へ常設しない。
/.claude/pdfs/
