database/backups/
database-backups_*.sql
backup-*.sql
d1-export*.sql
local-r2/database-backups/

# Windows reserved names
NUL

# Test images
local-r2/test-images/

# Temporary test scripts
test-*.ts
test-*.js

# Turborepo cache
.turbo

# Large mock data (keep locally, not in git)
packages/mock/src/estat-api/stats-data/*.json

# Test output files (development only)
apps/web/src/features/estat-api/stats-data/__test_outputs__/
apps/web/src/features/gis/geoshape/adapters/__test_outputs__/

