{
  "name": "stats47-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "coconala-publish": "node .claude/scripts/coconala/coconala-publish.mjs",
    "coconala-edit": "node .claude/scripts/coconala/coconala-edit.mjs",
    "coconala-delete-draft": "node .claude/scripts/coconala/coconala-delete-draft.mjs",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "design-system:check": "npm run design-system:check --workspace apps/web",
    "docs:fix": "node .claude/scripts/lib/check-docs-governance.cjs --fix",
    "docs:report": "node .claude/scripts/lib/check-docs-governance.cjs --json",
    "docs:check": "node .claude/scripts/lib/check-docs-governance.cjs && node .claude/scripts/lib/check-docs-links.cjs --baseline",
    "docs:check:all": "node --test .claude/scripts/lib/__tests__/check-docs-governance.test.cjs .claude/scripts/lib/__tests__/check-docs-links.test.cjs && node .claude/scripts/lib/check-docs-governance.cjs --fail-on-warn && node .claude/scripts/lib/check-docs-links.cjs --baseline --orphans",
    "check:image-pipeline-policy": "node .claude/scripts/lib/audit-workflow-policy.cjs --strict",
    "blog-images:codex": "tsx apps/web/scripts/manage-blog-codex-backgrounds.ts",
    "check:blog-images": "npm run blog-images:codex -- check",
    "check:file-url-guard": "node .claude/scripts/lib/check-file-url-guard.cjs",
    "check:import-meta-dirname": "node .claude/scripts/lib/check-import-meta-dirname-guard.cjs",
    "preflight": "node .claude/scripts/lib/preflight-commit.mjs",
    "test:content-routines": "node --test .claude/scripts/lib/__tests__/content-generation-routine.test.cjs .claude/scripts/lib/__tests__/summarize-claude-execution.test.mjs .claude/scripts/lib/__tests__/record-claude-usage.test.mjs",
    "note:catalog:validate": "tsx .claude/scripts/note/catalog/validate-note-catalog.ts",
    "type-check:image-pipeline": "tsc --noEmit --skipLibCheck --incremental false -p apps/web/scripts/tsconfig.ogp.json && npm run type-check --workspace packages/r2-storage && npm run type-check --workspace packages/types",
    "test:image-pipeline": "vitest run apps/web/scripts/lib/__tests__/image-generation-manifest.test.ts apps/web/scripts/lib/__tests__/image-entity-policy.test.ts apps/web/scripts/lib/__tests__/image-pipeline-source-policy.test.ts apps/web/scripts/lib/__tests__/blog-ogp-visual.test.ts apps/web/scripts/lib/__tests__/blog-ai-background-cache.test.ts apps/web/scripts/lib/__tests__/blog-codex-background-catalog.test.ts apps/web/scripts/lib/__tests__/blog-image-render.test.ts packages/r2-storage/src/scripts/__tests__/push-generated-image-set.test.ts packages/r2-storage/src/scripts/__tests__/push-exact-r2-assets.test.ts && node --test .claude/scripts/lib/__tests__/audit-workflow-policy.test.cjs .claude/scripts/lib/__tests__/pre-commit-guard-paths.test.cjs .claude/scripts/lib/__tests__/gallery-collectors.test.mjs",
    "test:packages": "vitest run --project '@stats47/*'",
    "type-check": "NODE_OPTIONS=\"--max-old-space-size=4096\" turbo run type-check && npm run type-check:scripts",
    "type-check:scripts": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit --skipLibCheck -p apps/web/scripts/tsconfig.json && tsc --noEmit --skipLibCheck -p packages/database/scripts/tsconfig.json && tsc --noEmit --skipLibCheck -p packages/ranking/scripts/tsconfig.json && tsc --noEmit --skipLibCheck -p apps/remotion/scripts/tsconfig.json && tsc --noEmit --skipLibCheck -p .claude/skills/ads/scout-asp/scripts/tsconfig.json && tsc --noEmit --skipLibCheck -p packages/product-factory/scripts/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "knip": "knip",
    "knip:report": "knip --reporter json > knip-report-all.json",
    "db:studio": "cd packages/database && cross-env DB_LOCAL=true npx drizzle-kit studio",
    "admin": "npm run dev --workspace=apps/admin",
    "r2:upload": "tsx packages/r2-storage/src/scripts/sync-upload.ts",
    "r2:download": "tsx packages/r2-storage/src/scripts/sync-download.ts",
    "r2:ges-portrait": "tsx packages/r2-storage/src/scripts/generate-portrait-videos.ts",
    "fetch-psi-audit": "node .claude/scripts/psi/fetch-psi-audit.mjs",
    "psi-audit:check": "node .claude/scripts/psi/psi-threshold-check.mjs",
    "psi-audit:digest": "node .claude/scripts/psi/psi-update-digest.mjs",
    "state:snapshots:prune": "node .claude/scripts/lib/prune-state-snapshots.mjs",
    "test:alert-lifecycle": "node --test .claude/scripts/lib/__tests__/alert-issue-lifecycle.test.cjs .claude/scripts/lib/__tests__/prune-state-snapshots.test.mjs",
    "test:workflow-commit-back": "node --test .claude/scripts/lib/__tests__/workflow-commit-back.test.cjs .claude/scripts/lib/__tests__/sync-snapshots-run-contract.test.mjs",
    "test:backlog-loop": "node --test .claude/scripts/backlog-loop/__tests__/*.test.cjs .claude/scripts/lib/__tests__/backlog-lib.test.cjs",
    "test:audit-scripts": "node --test .claude/scripts/audit/__tests__/*.test.mjs",
    "cloudflare-usage:fetch": "node .claude/scripts/cloudflare/fetch-usage.mjs",
    "cloudflare-usage:digest": "node .claude/scripts/cloudflare/update-digest.mjs",
    "cloudflare-usage:check": "node .claude/scripts/cloudflare/threshold-check.mjs",
    "fetch-gsc-snapshot": "node .claude/scripts/metrics/fetch-gsc-snapshot.mjs",
    "fetch-ga4-snapshot": "node .claude/scripts/metrics/fetch-ga4-snapshot.mjs",
    "fetch-adsense-snapshot": "node .claude/scripts/metrics/fetch-adsense-snapshot.mjs",
    "metrics:digest": "node .claude/scripts/metrics/update-history-csv.mjs",
    "metrics:adsense-impact": "node .claude/scripts/metrics/measure-adsense-impact.mjs",
    "metrics:check-period-contract": "node .claude/scripts/metrics/check-period-contract.mjs",
    "metrics:adsense-diagnostics": "node .claude/scripts/metrics/adsense-diagnostics-run.mjs",
    "metrics:test": "node --test .claude/scripts/metrics/__tests__/*.test.mjs",
    "psi:test": "node --test .claude/scripts/psi/__tests__/*.test.mjs",
    "effect-verdict": "node .claude/scripts/lib/effect-verdict/cli.mjs",
    "effect-verdict:test": "node --test .claude/scripts/lib/__tests__/effect-verdict.test.mjs .claude/scripts/lib/__tests__/write-past-effects.test.mjs",
    "metrics:check-adsense-units": "node .claude/scripts/metrics/check-adsense-unit-mapping.mjs",
    "google-admin:audit-api": "node .claude/scripts/google-admin/cli.mjs audit-api",
    "google-admin:audit-ui": "node .claude/scripts/google-admin/cli.mjs audit-ui",
    "google-admin:audit": "node .claude/scripts/google-admin/cli.mjs audit-ui",
    "google-admin:plan": "node .claude/scripts/google-admin/cli.mjs plan",
    "google-admin:apply": "node .claude/scripts/google-admin/cli.mjs apply",
    "google-admin:apply-ui": "node .claude/scripts/google-admin/cli.mjs apply-ui",
    "google-admin:test": "node --test .claude/scripts/google-admin/__tests__/*.test.mjs",
    "search-growth:collect": "node .claude/scripts/search-growth/collect.mjs",
    "search-growth:normalize": "node .claude/scripts/search-growth/normalize.mjs",
    "search-growth:analyze": "node .claude/scripts/search-growth/analyze.mjs",
    "search-growth:report": "node .claude/scripts/search-growth/report.mjs",
    "search-growth:status": "node .claude/scripts/search-growth/cli.mjs status",
    "search-growth:next": "node .claude/scripts/search-growth/cli.mjs next",
    "search-growth:triage": "node .claude/scripts/search-growth/cli.mjs triage",
    "search-growth:approve": "node .claude/scripts/search-growth/cli.mjs approve",
    "search-growth:dismiss": "node .claude/scripts/search-growth/cli.mjs dismiss",
    "search-growth:measure": "node .claude/scripts/search-growth/cli.mjs measure",
    "search-growth:all": "node .claude/scripts/search-growth/cli.mjs all",
    "search-growth:test": "node --test .claude/scripts/search-growth/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "@types/shapefile": "^0.6.4",
    "@types/unzipper": "^0.10.11",
    "csv-parse": "^6.1.0",
    "googleapis": "^171.4.0",
    "knip": "^5.82.1",
    "prettier": "^3.4.2",
    "turbo": "^2.8.9",
    "youtube-transcript": "^1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "next": "15.5.23",
    "jsdom": "25.0.1"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "d3": "^7.9.0",
    "d3-scale-chromatic": "^3.1.0",
    "http-proxy-agent": "^8.0.0",
    "https-proxy-agent": "^8.0.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3"
  }
}
