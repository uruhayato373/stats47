{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/pre-bash-safety.js'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/check-local-db.js'"
          },
          {
            "type": "command",
            "command": "node '.codex/hooks/session-guard.js'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/check-consistency-on-stop.js'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/session-guard.js'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/check-weekly-cadence-on-stop.js'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '.codex/hooks/check-docs-on-stop.js'"
          }
        ]
      }
    ]
  }
}
