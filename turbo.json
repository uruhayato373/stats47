{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxSize": "2GB",
  "concurrency": "2",
  "//": "globalPassThroughEnv: turbo 2.x は既定が strict env mode で、宣言しない環境変数を子プロセスへ渡さない。ここに挙げるのは『どこで動かすか』だけを決める実行環境の変数で、成果物を変えないため cache key にも入らない (passThrough の定義)。★NODE_EXTRA_CA_CERTS が落ちると、TLS を傍受するプロキシ配下 (Claude Code のエージェントプロキシ / 社内 i-FILTER) で Node の全 HTTPS が SELF_SIGNED_CERT_IN_CHAIN になり、dev サーバーが R2 を一切読めなくなる (2026-08-04 実測: npm run dev:web だけが壊れ、turbo を介さない cd apps/web && npm run dev は動いた)。★PORT / PWSH_PATH / R2_DEV_GATEWAY* / WEB_DEV_BUNDLER は apps/web/scripts/dev-server.ts が読む。未宣言だと全部落ちるため、local-environment.md が案内している R2_DEV_GATEWAY=0 による gateway 無効化が npm run dev:web 経由では効いていなかった (2026-08-21 に発見)。",
  "globalPassThroughEnv": [
    "NODE_EXTRA_CA_CERTS",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "PORT",
    "PWSH_PATH",
    "R2_DEV_GATEWAY",
    "R2_DEV_GATEWAY_CACHE_SECONDS",
    "R2_DEV_GATEWAY_PORT",
    "R2_DEV_GATEWAY_UPSTREAM",
    "WEB_DEV_HOST",
    "WEB_DEV_BUNDLER"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/standalone/**/.next/cache/**",
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/metrics/**/*.ts",
        "$TURBO_ROOT$/data/metric-sources/**/*.ts",
        "$TURBO_ROOT$/data/themes/catalogs/*.json",
        "$TURBO_ROOT$/data/themes/viewpoints/*.json",
        "$TURBO_ROOT$/data/themes/japan/*.json",
        "$TURBO_ROOT$/data/municipalities/catalog/*.json",
        "$TURBO_ROOT$/data/areas/**/*.json",
        "$TURBO_ROOT$/data/products/packs/*.json",
        "$TURBO_ROOT$/data/products/kindle/*.json",
        "$TURBO_ROOT$/data/note/series.json",
        "$TURBO_ROOT$/data/ads/*.json",
        "$TURBO_ROOT$/data/affiliate/ledger/*.json",
        "$TURBO_ROOT$/data/site/url-history/*.json",
        "$TURBO_ROOT$/data/geo/ksj/*.json",
        "$TURBO_ROOT$/data/geo/analyses/*.json",
        "$TURBO_ROOT$/data/geo/source-pages/*.json",
        "$TURBO_ROOT$/data/open-data/**/*.json",
        "$TURBO_ROOT$/data/surveys/master/*.json",
        "$TURBO_ROOT$/data/surveys/analysis-units/*.json",
        "$TURBO_ROOT$/data/surveys/editorial/*.json",
        "$TURBO_ROOT$/data/categories/*.json",
        "$TURBO_ROOT$/data/categories/topics/*.json"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/metrics/**/*.ts",
        "$TURBO_ROOT$/data/metric-sources/**/*.ts",
        "$TURBO_ROOT$/data/themes/catalogs/*.json",
        "$TURBO_ROOT$/data/themes/viewpoints/*.json",
        "$TURBO_ROOT$/data/themes/japan/*.json",
        "$TURBO_ROOT$/data/municipalities/catalog/*.json",
        "$TURBO_ROOT$/data/areas/**/*.json",
        "$TURBO_ROOT$/data/products/packs/*.json",
        "$TURBO_ROOT$/data/products/kindle/*.json",
        "$TURBO_ROOT$/data/note/series.json",
        "$TURBO_ROOT$/data/ads/*.json",
        "$TURBO_ROOT$/data/affiliate/ledger/*.json",
        "$TURBO_ROOT$/data/site/url-history/*.json",
        "$TURBO_ROOT$/data/geo/ksj/*.json",
        "$TURBO_ROOT$/data/geo/analyses/*.json",
        "$TURBO_ROOT$/data/geo/source-pages/*.json",
        "$TURBO_ROOT$/data/open-data/**/*.json",
        "$TURBO_ROOT$/data/surveys/master/*.json",
        "$TURBO_ROOT$/data/surveys/analysis-units/*.json",
        "$TURBO_ROOT$/data/surveys/editorial/*.json",
        "$TURBO_ROOT$/data/categories/*.json",
        "$TURBO_ROOT$/data/categories/topics/*.json"
      ]
    },
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/metrics/**/*.ts",
        "$TURBO_ROOT$/data/metric-sources/**/*.ts",
        "$TURBO_ROOT$/data/themes/catalogs/*.json",
        "$TURBO_ROOT$/data/themes/viewpoints/*.json",
        "$TURBO_ROOT$/data/themes/japan/*.json",
        "$TURBO_ROOT$/data/municipalities/catalog/*.json",
        "$TURBO_ROOT$/data/areas/**/*.json",
        "$TURBO_ROOT$/data/products/packs/*.json",
        "$TURBO_ROOT$/data/products/kindle/*.json",
        "$TURBO_ROOT$/data/note/series.json",
        "$TURBO_ROOT$/data/ads/*.json",
        "$TURBO_ROOT$/data/affiliate/ledger/*.json",
        "$TURBO_ROOT$/data/site/url-history/*.json",
        "$TURBO_ROOT$/data/geo/ksj/*.json",
        "$TURBO_ROOT$/data/geo/analyses/*.json",
        "$TURBO_ROOT$/data/geo/source-pages/*.json",
        "$TURBO_ROOT$/data/open-data/**/*.json",
        "$TURBO_ROOT$/data/surveys/master/*.json",
        "$TURBO_ROOT$/data/surveys/analysis-units/*.json",
        "$TURBO_ROOT$/data/surveys/editorial/*.json",
        "$TURBO_ROOT$/data/categories/*.json",
        "$TURBO_ROOT$/data/categories/topics/*.json"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/metrics/**/*.ts",
        "$TURBO_ROOT$/data/metric-sources/**/*.ts",
        "$TURBO_ROOT$/data/themes/catalogs/*.json",
        "$TURBO_ROOT$/data/themes/viewpoints/*.json",
        "$TURBO_ROOT$/data/themes/japan/*.json",
        "$TURBO_ROOT$/data/municipalities/catalog/*.json",
        "$TURBO_ROOT$/data/areas/**/*.json",
        "$TURBO_ROOT$/data/products/packs/*.json",
        "$TURBO_ROOT$/data/products/kindle/*.json",
        "$TURBO_ROOT$/data/note/series.json",
        "$TURBO_ROOT$/data/ads/*.json",
        "$TURBO_ROOT$/data/affiliate/ledger/*.json",
        "$TURBO_ROOT$/data/site/url-history/*.json",
        "$TURBO_ROOT$/data/geo/ksj/*.json",
        "$TURBO_ROOT$/data/geo/analyses/*.json",
        "$TURBO_ROOT$/data/geo/source-pages/*.json",
        "$TURBO_ROOT$/data/open-data/**/*.json",
        "$TURBO_ROOT$/data/surveys/master/*.json",
        "$TURBO_ROOT$/data/surveys/analysis-units/*.json",
        "$TURBO_ROOT$/data/surveys/editorial/*.json",
        "$TURBO_ROOT$/data/categories/*.json",
        "$TURBO_ROOT$/data/categories/topics/*.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "R2_PUBLIC_FETCH_URL",
        "NEXT_PUBLIC_R2_PUBLIC_URL",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_S3_ENDPOINT",
        "AD_SLOT_PREVIEW",
        "BLOG_PREVIEW_SLUG",
        "BLOG_PREVIEW_R2_URL"
      ]
    },
    "pipeline:images": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        ".local/r2/ranking/**/*.json"
      ],
      "outputs": [
        ".local/r2/ranking/**/images/**",
        ".local/r2/ranking/**/reels/**"
      ]
    },
    "pipeline:captions": {
      "dependsOn": [
        "pipeline:images"
      ],
      "inputs": [
        ".local/r2/ranking/**/*.json"
      ],
      "outputs": [
        ".local/r2/ranking/**/reels/*.md"
      ]
    },
    "pipeline:refine": {
      "dependsOn": [
        "pipeline:captions"
      ],
      "inputs": [
        ".local/r2/ranking/**/reels/*.md"
      ],
      "outputs": [
        ".local/r2/ranking/**/reels/*.png"
      ]
    },
    "pipeline:render": {
      "dependsOn": [
        "pipeline:refine"
      ],
      "inputs": [
        ".local/r2/ranking/**/reels/*.png"
      ],
      "outputs": [
        ".local/r2/ranking/**/video/*.mp4"
      ]
    }
  }
}
