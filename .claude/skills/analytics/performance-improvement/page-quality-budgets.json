{
  "version": 1,
  "description": "ページ肥大化・重複・表示速度低下の合否判定閾値 (page_type × metric_key の組で一意)。PSI/Lighthouseのbudgets.jsonとは別ファイル (対象がDOM/リンク/広告/構造化データなど静的解析中心のため)。comparison=absoluteは1回の計測値そのもの、delta_pctは直近履歴からの増加率(%)を見る。初期値はpage-quality:check初回実行時の実測を基に暫定設定し、以後は実測で調整する。",
  "schema": {
    "page_type": "対象テンプレート (home/prefecture-list/prefecture-detail/municipality/ranking/category/theme/geo-analysis/blog/survey/other/all)",
    "metric_key": "計測項目キー (types.ts の MetricKey)",
    "comparison": "absolute (単発閾値) | delta_pct (直近履歴からの増加率%)",
    "threshold": "閾値",
    "operator": "<= | >= | < | >",
    "severity": "error | warning"
  },
  "budgets": [
    { "page_type": "all", "metric_key": "html_bytes", "comparison": "absolute", "threshold": 900000, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "html_bytes", "comparison": "delta_pct", "threshold": 30, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "rsc_bytes", "comparison": "absolute", "threshold": 500000, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "rsc_bytes", "comparison": "delta_pct", "threshold": 30, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "dom_nodes", "comparison": "absolute", "threshold": 4000, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "dom_nodes", "comparison": "delta_pct", "threshold": 30, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "duplicate_link_ratio", "comparison": "absolute", "threshold": 0.3, "operator": "<=", "severity": "error", "note": "同一hrefのリンクが全体の30%を超える=意図しない大量重複" },
    { "page_type": "all", "metric_key": "duplicate_link_ratio", "comparison": "absolute", "threshold": 0.15, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "jsonld_syntax_errors", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "jsonld_bytes", "comparison": "absolute", "threshold": 50000, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "jsonld_bytes", "comparison": "delta_pct", "threshold": 30, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "ad_duplicate_count", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "同一クリック先の広告リンクが同一ページに複数回出現" },
    { "page_type": "all", "metric_key": "console_errors", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "page_errors", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "mobile_horizontal_scroll", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "error" },
    { "page_type": "all", "metric_key": "small_tap_targets", "comparison": "absolute", "threshold": 5, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "lcp_ms", "comparison": "absolute", "threshold": 4000, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "cls", "comparison": "absolute", "threshold": 0.25, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "inp_ms", "comparison": "absolute", "threshold": 500, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "ttfb_ms", "comparison": "absolute", "threshold": 1500, "operator": "<=", "severity": "warning" },
    { "page_type": "all", "metric_key": "broken_images", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "error", "note": "自サイト/R2 の画像が 4xx/5xx。通信失敗は数えない (未確認として件数だけ出す)" },
    { "page_type": "all", "metric_key": "degraded_images", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "画面側の代替表示がある画像の欠落 (特産品画像は頭文字タイルに切り替わる)。壊れては見えないが本来の画像が出ていない" },
    { "page_type": "all", "metric_key": "empty_headings", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "文字も alt も aria-label も無い見出し。読み込み中の仮枠 (animate-pulse) は除外" },
    { "page_type": "all", "metric_key": "duplicate_data_source_sections", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "「データ出典」見出しが 2 つ以上 = 本文の手書き節と DataSourceList が並んでいる (2026-09-25 出典表示の統一)" },
    { "page_type": "all", "metric_key": "external_links_same_tab", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "外部サイトへのリンクなのに新しいタブで開かない数。コードは ExternalAnchor + external-link-contract.test.ts で止め、ここは記事本文・変数 URL を含む描画後の漏れを拾う (2026-09-25)" },
    { "page_type": "all", "metric_key": "clipped_text", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "代表URLのみ (ブラウザ)。overflow hidden で文字が切れている要素。ellipsis / line-clamp は除外" },
    { "page_type": "all", "metric_key": "overlapping_tap_targets", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "代表URLのみ (ブラウザ)。タップできる要素どうしが小さい方の面積の25%以上重なる" },
    { "page_type": "all", "metric_key": "chart_text_issues", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "代表URLのみ (ブラウザ)。ページに直接描いた SVG チャートの文字 (目盛り・凡例・単位) が描画範囲から切れている数 + 文字どうしの重なり。<img> の静的 SVG は blog_svg_text_issues が見る (2026-09-25)" },
    { "page_type": "all", "metric_key": "blog_svg_text_issues", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "全記事 (静的)。<img> で埋め込んだ記事チャート SVG のうち、文字がキャンバスからはみ出す・文字どうしが重なるものの枚数。判定は svg-lint の findChartTextIssues (2026-09-25)" },
    { "page_type": "all", "metric_key": "responsive_layout_issues", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "代表URLのみ。640/768/992/1024/1440/1920px の各幅での横スクロール・文字の切れ・タップ要素の重なりの合計" },
    { "page_type": "all", "metric_key": "a11y_violations", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "代表URLのみ (ブラウザ)。axe-core WCAG 2 A/AA の critical/serious 規則数" },

    { "page_type": "prefecture-detail", "metric_key": "dom_nodes", "comparison": "absolute", "threshold": 3500, "operator": "<=", "severity": "warning", "note": "2026-09 area-all-optimizationでDOM削減対応後の目安。実測で調整する" },
    { "page_type": "ranking", "metric_key": "html_bytes", "comparison": "absolute", "threshold": 700000, "operator": "<=", "severity": "warning", "note": "PERF-RANKING-PAYLOAD-01対応後の目安。実測で調整する" },
    { "page_type": "all", "metric_key": "internal_jargon_terms", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "画面に出た内部用語 (INTERNAL_JARGON_TERMS)。2026-09-27 全 6,336 URL 実測で 256 URL (保存則 253・lineage 13・rankingKey 3。県ページ 232)。実在の混入だが件数が多く修正前は warning" },
    { "page_type": "all", "metric_key": "unit_symbol_mixing", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "同じページで % と ％ が混在。2026-09-27 実測 2,508 URL (ranking 1,576・県ページ 855)。サイト横断の揺れで表示の誤りではないため warning" },
    { "page_type": "all", "metric_key": "abnormal_value_strings", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "NaN / undefined / Infinity / [object Object] が画面に出た (code/pre は除く)。2026-09-27 実測 1 URL で、技術記事の本文が語として書いた誤検知。blocker にしない" },
    { "page_type": "all", "metric_key": "same_shop_ad_duplicates", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "同じ ASP 案件の別リンクの広告。2026-09-27 実測 262 URL (ranking 208・記事 54、ほぼ楽天の同じ店の商品違い)。意図した商品一覧もあるので warning" },
    { "page_type": "all", "metric_key": "title_changed", "comparison": "absolute", "threshold": 0, "operator": "<=", "severity": "warning", "note": "<title> が前回の週次から変わった。選定入力が変わった正当な変化もあるので warning (初回は前回の title が無く測らない)" },
    { "page_type": "blog", "metric_key": "small_text_count", "comparison": "absolute", "threshold": 10, "operator": "<=", "severity": "warning", "note": "412px で 11px 未満の見える文字 (SVG 除く)。2026-09-27 実測の代表URL・variants の最大 10 を上限にし、増えたら指摘する (縮小専用。直したら下げる)" },
    { "page_type": "blog", "metric_key": "mobile_page_height", "comparison": "absolute", "threshold": 12400, "operator": "<=", "severity": "warning", "note": "412px のページ高さ。2026-09-27 実測の最大 10744px の 1.15 倍" },
    { "page_type": "blog-article", "metric_key": "small_text_count", "comparison": "absolute", "threshold": 1, "operator": "<=", "severity": "warning", "note": "412px で 11px 未満の見える文字 (SVG 除く)。2026-09-27 実測の代表URL・variants の最大 1 を上限にし、増えたら指摘する (縮小専用。直したら下げる)" },
