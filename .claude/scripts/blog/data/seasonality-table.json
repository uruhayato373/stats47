{
  "_comment": "topic-queue の seasonality スコア用 (build-topic-queue.mjs が読む)。match は metric title / topic ラベルへの部分一致、months は需要の山 (1-12)。静的・手動保守。根拠は季節商材の一般的な検索需要 (鍋=冬、引越し=1-3月) — 追加時は Google Trends 等で裏取りする。",
  "patterns": [
    { "label": "冬の温食", "match": ["うどん", "そば", "ラーメン", "鍋", "おでん", "豆腐", "みそ", "味噌", "しじみ"], "months": [11, 12, 1, 2] },
    { "label": "夏の冷食・飲料", "match": ["アイス", "ビール", "炭酸", "飲料", "そうめん", "ゆかた", "エアコン"], "months": [6, 7, 8] },
    { "label": "引越し・移住", "match": ["引越", "移住", "転入", "転出", "賃貸", "家賃", "住宅"], "months": [1, 2, 3] },
    { "label": "観光・宿泊", "match": ["観光", "宿泊", "旅行", "ホテル", "旅館"], "months": [7, 8, 9, 10] },
    { "label": "進学・受験", "match": ["進学", "大学", "受験", "学習塾", "教育費"], "months": [10, 11, 12, 1] },
    { "label": "ボーナス・貯蓄", "match": ["貯蓄", "貯金", "所得", "年収", "給与"], "months": [6, 7, 12] },
    { "label": "年末年始の食卓", "match": ["餅", "かまぼこ", "数の子", "そば"], "months": [12, 1] },
    { "label": "新生活・家電", "match": ["家電", "家具", "通勤", "通学"], "months": [3, 4] },
    { "label": "防災", "match": ["地震", "水害", "災害", "台風"], "months": [8, 9] },
    { "label": "花粉・健康", "match": ["医療", "病院", "健康寿命"], "months": [2, 3] }
  ]
