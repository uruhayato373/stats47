{
  "_comment": "週次・月次レビューと計画の配線の正本 (2026-10-01、doboku-note の review-wiring を stats47 の計測→記録→改善サイクルへ移植)。読み口は .claude/scripts/management/lib/review-cadence.mjs だけ。検査 = check-review-cadence.mjs (Stop hook・review-cadence-guard.yml・docs:check DG084)、表示 = 管理画面 /strategy/reviews、週次メトリクス Issue の「サイクルの健全性」節。contractFrom より前の期間は必須見出しと申し送りの振り分けを検査しない (遡って書き直さない)。inputs はレビューのスキルが実際に使うコマンド・state で、run は SKILL.md に同じ文字列があること、read はパスが実在することを検査する。",
  "handoffRouting": {
    "marker": "→ 振り分け:",
    "routes": [
      "backlog / improvements のカード ID (実在すること)",
      "EXP-NNN (.claude/state/experiments.json に実在すること)",
      "#Issue 番号",
      "定常 (週次・月次の定常作業で、カードを作らない)",
      "見送り (理由を同じ行に書く)"
    ]
  },
  "cadences": {
    "weekly": {
      "label": "週次レビュー",
      "skill": ".claude/skills/management/weekly-review/SKILL.md",
      "command": "/weekly-review",
      "dir": ".claude/skills/management/weekly-review/reference/reviews",
      "periodPattern": "^(\\d{4}-W\\d{2})\\.md$",
      "contractFrom": "2026-W40",
      "requiredSections": [
        "サマリー",
        "計画 vs 実績",
        "KPI ツリー",
        "計測→記録→改善サイクル",
        "課題・ブロッカー",
        "来週への申し送り"
      ],
      "handoffSection": "来週への申し送り",
      "inputs": [
        { "label": "NSM 週次 snapshot", "run": "node .claude/scripts/snapshot-weekly-metrics.mjs" },
        { "label": "事業計画の検証", "run": "npm run business-plan:check" },
        { "label": "GSC 入力契約", "run": "node .claude/scripts/gsc/audit-operations-cycle.mjs --stage review-input" },
        { "label": "検索成長の候補", "run": "npm run search-growth:status" },
        { "label": "週次収益 (NSM)", "run": "node .claude/scripts/metrics/generate-weekly-metrics-issue.mjs" },
        { "label": "認証付き計測", "run": "npm run measurement:status" },
        { "label": "計測→記録→改善サイクルの state", "read": ".claude/state/metrics/measurement-cycle/LATEST.md" },
        { "label": "無人 triage の結果", "read": ".claude/state/metrics/measurement-cycle/triage-latest.json" },
        { "label": "今週の計画", "read": ".claude/todo/weekly.md" },
        { "label": "保存後の接続ゲート", "run": "node .claude/scripts/gsc/audit-operations-cycle.mjs --stage review" },
        { "label": "レビューの契約検査", "run": "node .claude/scripts/management/check-review-cadence.mjs" }
      ]
    },
    "monthly": {
      "label": "月次レビュー",
      "skill": ".claude/skills/management/monthly-review/SKILL.md",
      "command": "/monthly-review",
      "dir": ".claude/skills/management/monthly-review/reference/reviews",
      "periodPattern": "^(\\d{4}-\\d{2})\\.md$",
      "dueDay": 3,
      "contractFrom": "2026-09",
      "requiredSections": [
        "サマリー",
        "前月の重点の判定",
        "KPI ツリーの判定",
        "週次レビューの総括",
        "施策の効果判定",
        "計測→記録→改善サイクル",
        "課題・ブロッカー",
        "来月への申し送り"
      ],
      "handoffSection": "来月への申し送り",
      "inputs": [
        { "label": "前月の週次レビュー", "read": ".claude/skills/management/weekly-review/reference/reviews" },
        { "label": "前月の月次計画", "read": ".claude/todo/monthly.md" },
        { "label": "計測サイクルの週次履歴", "read": ".claude/state/metrics/measurement-cycle/history.csv" },
        { "label": "効果判定 (閾値エンジン)", "read": ".claude/state/effect-verdict" },
        { "label": "KPI ツリー", "read": ".claude/state/business-plan/kpi-tree.json" },
        { "label": "楽天アフィリエイト成果", "read": ".claude/state/metrics/affiliate/rakuten-results.json" },
        { "label": "改善施策", "read": ".claude/todo/improvements.md" },
        { "label": "レビューの契約検査", "run": "node .claude/scripts/management/check-review-cadence.mjs" }
      ]
    }
  },
  "plans": {
    "weekly": { "label": "週次計画", "file": ".claude/todo/weekly.md", "command": "/weekly-plan" },
    "monthly": { "label": "月次計画", "file": ".claude/todo/monthly.md", "command": "/monthly-plan", "dueDay": 3 }
  }
}
