{
  "_comment": "週次・月次レビューと計画の配線の正本 (2026-10-01、doboku-note の review-wiring を stats47 の計測→記録→改善サイクルへ移植)。読み口は .claude/scripts/management/lib/review-cadence.mjs だけ。検査 = check-review-cadence.mjs (Stop hook・review-cadence-guard.yml・docs:check DG084)、表示 = 管理画面 /strategy/reviews/{weekly,monthly}、週次メトリクス Issue の「サイクルの健全性」節。contractFrom より前の期間は必須見出しと申し送りの振り分けを検査しない (遡って書き直さない)。inputs はレビューのスキルが実際に使うコマンド・state で、run は SKILL.md に同じ文字列があること、read はパスが実在することを検査する。",
  "handoffRouting": {
    "marker": "→ 振り分け:",
    "routes": [
      "backlog / improvements のカード ID (実在すること)",
      "EXP-NNN (data/business/experiments.json に実在すること)",
      "#Issue 番号",
      "定常 (週次・月次の定常作業で、カードを作らない)",
      "見送り (理由を同じ行に書く)"
    ]
  },
  "cadences": {
    "weekly": {
      "label": "週次レビュー",
      "skill": ".claude/skills/management/weekly-review/SKILL.md",
      "command": "/weekly-review",
      "dir": "data/reviews/weekly",
      "periodPattern": "^(\\d{4}-W\\d{2})\\.md$",
      "contractFrom": "2026-W40",
      "requiredSections": [
        "サマリー",
        "計画 vs 実績",
        "KPI ツリー",
        "計測→記録→改善サイクル",
        "課題・ブロッカー",
        "来週への申し送り"
      ],
      "handoffSection": "来週への申し送り",
      "inputs": [
        { "label": "NSM 週次 snapshot", "run": "node .claude/scripts/snapshot-weekly-metrics.mjs" },
        { "label": "事業計画の検証", "run": "npm run business-plan:check" },
        { "label": "GSC 入力契約", "run": "node .claude/scripts/gsc/audit-operations-cycle.mjs --stage review-input" },
        { "label": "検索成長の候補", "run": "npm run search-growth:status" },
        { "label": "週次収益 (NSM)", "run": "node .claude/scripts/metrics/generate-weekly-metrics-issue.mjs" },
        { "label": "認証付き計測", "run": "npm run measurement:status" },
        { "label": "計測→記録→改善サイクルの state", "read": "data/measurement-cycle/LATEST.md" },
        { "label": "無人 triage の結果", "read": "data/measurement-cycle/triage-latest.json" },
        { "label": "今週の計画", "read": ".claude/todo/weekly.md" },
        { "label": "保存後の接続ゲート", "run": "node .claude/scripts/gsc/audit-operations-cycle.mjs --stage review" },
        { "label": "レビューの契約検査", "run": "node .claude/scripts/management/check-review-cadence.mjs" }
      ]
    },
    "monthly": {
      "label": "月次レビュー",
      "skill": ".claude/skills/management/monthly-review/SKILL.md",
      "command": "/monthly-review",
      "dir": "data/reviews/monthly",
      "periodPattern": "^(\\d{4}-\\d{2})\\.md$",
      "dueDay": 3,
      "contractFrom": "2026-09",
      "requiredSections": [
        "サマリー",
        "前月の重点の判定",
        "KPI ツリーの判定",
        "週次レビューの総括",
        "収益の締め",
        "施策の効果判定",
        "実験の判定",
        "計測→記録→改善サイクル",
        "点検と Issue",
        "課題・ブロッカー",
        "来月への申し送り"
      ],
      "handoffSection": "来月への申し送り",
      "inputs": [
        { "label": "前月の週次レビュー", "read": "data/reviews/weekly" },
        { "label": "前月の月次計画", "read": ".claude/todo/monthly.md" },
        { "label": "計測サイクルの週次履歴", "read": "data/measurement-cycle/history.csv" },
        { "label": "効果判定 (閾値エンジン)", "read": "data/effect-verdict" },
        { "label": "KPI ツリー", "read": ".claude/state/business-plan/kpi-tree.json" },
        { "label": "楽天アフィリエイト成果", "read": "data/affiliate/rakuten-results.json" },
        { "label": "A8 成果", "read": "data/affiliate/a8-results.json" },
        { "label": "もしも成果", "read": "data/affiliate/moshimo-results.json" },
        { "label": "商品の販売台帳", "read": "data/products/sales-ledger.json" },
        { "label": "週次収益 (NSM) の各週", "run": "node .claude/scripts/metrics/generate-weekly-metrics-issue.mjs" },
        { "label": "NSM 改善実験", "read": "data/business/experiments.json" },
        { "label": "事業計画の state", "read": ".claude/state/business-plan/latest.json" },
        { "label": "Cloudflare 月次 snapshot", "read": "data/cloudflare/monthly-snapshots" },
        { "label": "月次 workflow の実行記録", "read": ".claude/state/metrics/monthly-jobs" },
        { "label": "競合の月次定点観測", "read": ".claude/skills/sns/competitor-scan/reference/reports" },
        { "label": "開いているアラート Issue", "run": "gh issue list --label auto-generated --state open" },
        { "label": "GSC 月次の接続ゲート", "run": "node .claude/scripts/gsc/audit-operations-cycle.mjs --stage monthly" },
        { "label": "改善施策", "read": ".claude/todo/improvements.md" },
        { "label": "レビューの契約検査", "run": "node .claude/scripts/management/check-review-cadence.mjs" }
      ]
    }
  },
  "monthlyJobs": {
    "_comment": "月次 workflow の実行結果 (record-monthly-job.mjs が .claude/state/metrics/monthly-jobs/<job>.json に残す)。day は JST の実行日。day + graceDays を過ぎても今月の記録が無い・failed なら毎朝のガードが error にする。月次レビューの手順「月次の自動処理」は対象月の記録で判定する",
    "dir": ".claude/state/metrics/monthly-jobs",
    "graceDays": 2,
    "jobs": [
      { "job": "ksj-catalog", "label": "国土数値情報カタログ", "workflow": "ksj-catalog-monthly.yml", "day": 2 },
      { "job": "estat-catalog", "label": "e-Stat カタログ", "workflow": "estat-catalog-monthly.yml", "day": 3 },
      { "job": "ctr-improvement", "label": "CTR 改善候補", "workflow": "ctr-improvement-monthly.yml", "day": 5 },
      { "job": "cloudflare-snapshot", "label": "Cloudflare 月次 snapshot", "workflow": "cloudflare-monthly-snapshot.yml", "day": 15 }
    ]
  },
  "plans": {
    "weekly": { "label": "週次計画", "file": ".claude/todo/weekly.md", "command": "/weekly-plan" },
    "monthly": { "label": "月次計画", "file": ".claude/todo/monthly.md", "command": "/monthly-plan", "dueDay": 3 }
  }
}
