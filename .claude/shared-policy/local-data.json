    },
    {
      "path": "apps/admin/.local/",
      "maxAgeDays": 60
    },
    {
      "path": "apps/web/.local/",
      "maxAgeDays": 60
    },
    {
      "path": "apps/remotion/.local/",
      "maxAgeDays": 60
    },
    {
      "path": "packages/product-factory/.local/",
      "maxAgeDays": 60
