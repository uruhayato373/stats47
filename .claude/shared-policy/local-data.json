    "**/coverage/",
    "**/__golden__/*-actual.png",
    "**/__golden__/*-diff.png",
    ".husky/_/",
    "apps/remotion/build/",
    "apps/remotion/out/",
    "apps/web/knip-report.json",
    "pnpm-lock.yaml",
    ".local/muni-data-products/_cache/",
    ".local/r2-manifest/",
